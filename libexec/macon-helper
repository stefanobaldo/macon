#!/bin/sh
# Root helper. Fixed, installed code -- never generated at runtime.
#
# It reads a validated descriptor and acts on data only. Commands supplied
# by the user (--busy-check, hooks) are executed de-privileged as the
# invoking user, which is required for correctness as much as for safety:
# root cannot reach the user's tmux socket, and would silently observe
# nothing.
set -u

# launchd starts a system daemon with NO user context, and lib/snapshot.sh
# defaults its state directory to $HOME/.local/state/macon. Under `set -u` an
# unset HOME is not a missing fallback but a FATAL error -- and it would land at
# the exact moment this helper needs to restore, with no log line to say why,
# because the shell exits before reaching one.
#
# Verified: a launchd system daemon inherits PATH and nothing else. The old
# `sudo nohup` launch passed HOME=/Users/<user> through, which is the only
# reason the snapshot was ever found; the plist now names MACON_STATE outright
# and this is the floor under it. /var/root is root's home on macOS.
#
# libexec/failsafe.sh carries the identical guard for the identical reason.
: "${HOME:=/var/root}"
export HOME

MACON_LIB=${MACON_LIB:-/usr/local/libexec/macon/lib}

if [ -z "${MACON_HELPER_SOURCED:-}" ]; then
    # shellcheck source=lib/common.sh
    . "$MACON_LIB/common.sh"
    # shellcheck source=lib/platform.sh
    . "$MACON_LIB/platform.sh"
    # shellcheck source=lib/decide.sh
    . "$MACON_LIB/decide.sh"
    # shellcheck source=lib/session.sh
    . "$MACON_LIB/session.sh"
    # shellcheck source=lib/snapshot.sh
    . "$MACON_LIB/snapshot.sh"
    # shellcheck source=lib/records.sh
    . "$MACON_LIB/records.sh"
fi

# powermetrics is the only sampler that can block, and it runs as root at
# every poll. Bounded well under the 30s interval floor; a normal reading
# takes a fraction of a second.
MACON_THERMAL_TIMEOUT=20

# Hooks are user code. Spec 9.2: their failure is ignored and execution
# continues, so the only thing this bound protects is the loop itself.
MACON_HOOK_TIMEOUT=30

# How often the lid is looked at, and how long the watch leaves the panel alone
# after blanking it.
#
# The cadence cannot be the poll interval: that defaults to 300s, so a session
# would leave the screen burning under a closed lid for up to five minutes. It
# is a separate, much shorter clock for that reason.
#
# The grace exists because the panel takes about a second to fade. Without it
# the next few reads still see a lit display and blank it again, on a screen
# that is already on its way out.
MACON_LID_CADENCE=0.5
MACON_LID_GRACE=1

_HELPER_TAB=$(printf '\t')

# Consecutive polls seen off AC. It cannot be a shell variable: the loop reads
# each poll's decision through a command substitution, and a subshell's
# increments are discarded when it exits -- a counter kept in memory would
# reset to zero at every poll and the no-ac abort would never fire. The run
# directory is cleared at boot, so this cannot outlive the session either.
helper_offac_path() {
    printf '%s/offac\n' "$(sess_run_dir)"
}

_helper_offac_read() {
    _v=$(cat "$(helper_offac_path)" 2>/dev/null)
    _sess_is_number "$_v" || _v=0
    printf '%s\n' "$_v"
}

# An absolute path with nothing in it that can forge a descriptor line.
# Absolute because the helper's working directory is not the user's, so a
# relative path silently resolves somewhere else -- for the sentinel that
# means a session that can never observe its own completion.
_helper_is_abs_path() {
    case "$1" in
        /*) ;;
        *) return 1 ;;
    esac
    case "$1" in
        *"$_HELPER_TAB"* | *'
'*) return 1 ;;
    esac
    return 0
}

# Reads the thermal level under a bound, via a FILE rather than a pipe.
#
# This shape is what a bound that reaches only the direct child costs its
# caller, and it is the reason macon_run_timeout now runs the command in its own
# process group: plat_thermal_pressure runs powermetrics in a child of the
# process being timed, so a hung sampler used to outlive the kill and -- with
# its output collected up a command-substitution pipe -- hold that pipe open
# until it finished on its own. The poll then blocked for exactly as long as the
# sampler hung, on the one call the timeout exists to bound.
#
# The file is kept now that the group kill has closed that path. It costs a
# temporary file per poll and it is the reading that must not be able to stall
# the loop; a second, independent reason for the poll to survive a hung sampler
# is worth that.
_helper_sample_thermal() {
    _tf="$(sess_run_dir)/thermal.$$"
    : > "$_tf" 2>/dev/null || return 0
    macon_run_timeout "$MACON_THERMAL_TIMEOUT" plat_thermal_pressure \
        > "$_tf" 2>/dev/null
    cat "$_tf" 2>/dev/null
    rm -f "$_tf"
}

# Must root drop privilege before running this command? The answer is yes
# whenever the answer is not certainly no, and it is certainly no in exactly
# one case: this process is not root and is already the user the command was
# written by. Nothing else is a shortcut worth taking -- a wrong answer here
# runs user code as root and leaves no trace that it did.
#
# Split out as a pure function because the interesting case cannot be
# exercised by a test suite that does not run as root.
helper_needs_sudo() {
    _uid=$1
    _me=$2
    _target=$3
    [ "$_uid" = "0" ] && return 0
    [ "$_me" = "$_target" ] && return 1
    return 0
}

# Runs a user-supplied command as the invoking user, never as root.
helper_run_as_user() {
    _user=$1
    _timeout=$2
    _cmd=$3
    if helper_needs_sudo "$(id -u)" "$(id -un)" "$_user"; then
        macon_run_timeout "$_timeout" sudo -u "$_user" -- /bin/sh -c "$_cmd"
    else
        macon_run_timeout "$_timeout" /bin/sh -c "$_cmd"
    fi
}

# sess_validate covers the nine fields it was written against. These are the
# rest: the ones that become a sleep(1) argument, a kill(1) operand, an
# arithmetic operand or a path tested as root. Each is required only when the
# descriptor selects the feature that reads it, so a session that uses none of
# them carries none of them.
#
# The numeric guard is deliberately session.sh's own rather than a local copy:
# its bounds are load-bearing (an over-long value makes `[` exit 2, and the
# enclosing `if` then falls through instead of failing), and a second copy is
# a second place for those bounds to drift.
helper_validate_desc() {
    _d=$1
    sess_validate "$_d" || return 1
    _ok=0

    if [ "$(sess_get "$_d" policy)" = "extend" ]; then
        _v=$(sess_get "$_d" extend_by)
        if ! _sess_is_number "$_v"; then
            macon_warn "policy is extend but 'extend_by' is not a plain integer: '$_v'"
            _ok=1
        fi
    fi

    case "$(sess_get "$_d" completion)" in
        busy_check)
            if [ -z "$(sess_get "$_d" busy_check)" ]; then
                macon_warn "completion is busy_check but 'busy_check' is empty"
                _ok=1
            fi
            _v=$(sess_get "$_d" busy_timeout)
            if ! _sess_is_number "$_v"; then
                macon_warn "descriptor field 'busy_timeout' is not a plain integer: '$_v'"
                _ok=1
            fi
            ;;
        sentinel)
            _v=$(sess_get "$_d" sentinel_path)
            if ! _helper_is_abs_path "$_v"; then
                macon_warn "descriptor field 'sentinel_path' is not an absolute path: '$_v'"
                _ok=1
            fi
            ;;
        process)
            _v=$(sess_get "$_d" watch_pid)
            if ! _sess_is_number "$_v"; then
                macon_warn "descriptor field 'watch_pid' is not a plain integer: '$_v'"
                _ok=1
            fi
            ;;
    esac

    if [ -n "$(sess_get "$_d" hook_warn)" ]; then
        _v=$(sess_get "$_d" pre_warn)
        if ! _sess_is_number "$_v"; then
            macon_warn "a warn hook is set but 'pre_warn' is not a plain integer: '$_v'"
            _ok=1
        fi
    fi

    [ "$_ok" -eq 0 ]
}

# Spec 6.1 rule 3: the descriptor arrives in a user-owned file; the helper
# validates it and afterwards works only from its own copy, so the ceiling
# cannot be moved once the session has started.
helper_install_descriptor() {
    _src=$1
    _dst=$(sess_desc_path)
    mkdir -p "$(sess_run_dir)" || return 1

    if [ "$_src" = "$_dst" ]; then
        helper_validate_desc "$_dst" || return 1
    else
        _tmp="$_dst.tmp.$$"
        cp "$_src" "$_tmp" || return 1
        # Validate the COPY. Validating the original and then copying leaves a
        # window in which the file is rewritten between the two, and the
        # ceiling is precisely the field that would be rewritten.
        if ! helper_validate_desc "$_tmp"; then
            rm -f "$_tmp"
            return 1
        fi
        mv "$_tmp" "$_dst" || return 1
    fi

    # Root-owned, world-readable: `macon status` reads it, only root writes it.
    # Best effort, because a helper that is somehow not root should still run a
    # correct session -- it just cannot promise the file is untamperable.
    chmod 0644 "$_dst" 2>/dev/null || :
    chown 0:0 "$_dst" 2>/dev/null || :
    return 0
}

# A new session must not inherit the previous one's strike count. The counter
# lives in the run directory, which only a reboot clears -- so a helper that was
# killed off AC leaves a count behind, and the next session reads it at its
# first poll. Two strikes are then already spent before that session has seen
# anything, and a night ends within one interval of starting. It fails toward
# ending rather than toward staying awake, which is why it is a wart and not a
# hazard, but a session cut short is still the wrong answer.
helper_reset_counters() {
    rm -f "$(helper_offac_path)"
}

# Echoes yes | no | unknown.
helper_probe_busy() {
    _d=$1
    case "$(sess_get "$_d" completion)" in
        sentinel)
            if [ -e "$(sess_get "$_d" sentinel_path)" ]; then
                printf 'no\n'
            else
                printf 'yes\n'
            fi
            ;;
        process)
            # kill -0 answers "does this process exist", not "is it still the
            # one we wrapped": within one uptime the number can be recycled.
            # The ceiling is what bounds the damage; see spec 7.1.
            _pid=$(sess_get "$_d" watch_pid)
            if _sess_is_number "$_pid" && kill -0 "$_pid" 2>/dev/null; then
                printf 'yes\n'
            else
                printf 'no\n'
            fi
            ;;
        busy_check)
            _to=$(sess_get "$_d" busy_timeout)
            _sess_is_number "$_to" || _to=$MACON_HOOK_TIMEOUT
            if helper_run_as_user "$(sess_get "$_d" user)" "$_to" \
                "$(sess_get "$_d" busy_check)" >/dev/null 2>&1; then
                printf 'yes\n'
            else
                # Includes the timeout kill (143). Failing toward "not busy"
                # is deliberate: it fails toward letting the machine sleep.
                printf 'no\n'
            fi
            ;;
        *)
            # none, and anything unrecognised. Never "finished": an
            # unreadable completion source must not end a session early.
            printf 'unknown\n'
            ;;
    esac
}

# One poll: sample, evaluate, echo the decision.
helper_iterate() {
    _d=$1

    # The descriptor is validated once on arrival and then re-read at EVERY
    # poll, so it is re-validated at every poll. It is not a constant: a failed
    # sess_set can truncate it, and `macon off` deletes it -- including after
    # giving up on a helper that would not die, which leaves this loop reading
    # a file that is gone.
    #
    # sess_get answers a missing file with SUCCESS and no output, and an empty
    # operand makes `[ -ge ]` EXIT 2 on bash 3.2 rather than return false. That
    # does not fail the comparisons in macon_decide, it makes every one of them
    # fall through: the poll order stops being evaluated at all and the function
    # returns `continue` for ever, while the helper is still alive, so
    # sess_orphaned is false and `macon status` reports a healthy session. The
    # machine stays awake past its ceiling with nothing left to notice.
    #
    # Hence the direction: a session whose parameters cannot be read cannot be
    # evaluated, and a session that cannot be evaluated must not hold the
    # machine awake. The descriptor is the helper's own file and it is still
    # treated as untrustworthy at every poll, because the route by which it goes
    # bad is exactly the route nobody has classified yet.
    if ! helper_validate_desc "$_d"; then
        macon_warn "the session descriptor is no longer usable; ending the session"
        printf 'end:invalid-descriptor\n'
        return 0
    fi

    _now=$(macon_now)
    _id=$(sess_get "$_d" session_id)

    _thermal=$(_helper_sample_thermal)
    # powermetrics returns the remainder of its own line, so this text is not
    # ours. A tab or newline in it does not corrupt the value, it corrupts the
    # sample file -- and rec_append_sample refuses such a value outright, which
    # would cost the whole poll its battery reading and its place in the count.
    # Degrade the one field instead.
    case "$_thermal" in
        '' | *"$_HELPER_TAB"* | *'
'*) _thermal=unknown ;;
    esac

    _batt=$(plat_battery_pct)
    # A Mac with no battery, or an unreadable one, reads empty. -1 is the
    # sentinel rec_aggregate already uses for "no usable reading", and keeps
    # the column unambiguously non-blank: an empty field in a TSV row is
    # indistinguishable from a shifted one.
    _sess_is_number "$_batt" || _batt=-1

    if [ "$(plat_power_source)" = "ac" ]; then
        _ac=yes
        _offac=0
    else
        _ac=no
        _offac=$(( $(_helper_offac_read) + 1 ))
    fi
    printf '%s\n' "$_offac" > "$(helper_offac_path)"

    rec_append_sample "$_id" "$_now" "$_thermal" "$_ac" "$_batt" ||
        macon_warn "could not record a sample for session '$_id'"
    printf '%s\n' "$_now" > "$(sess_heartbeat_path)"

    macon_decide \
        "$_now" \
        "$(sess_get "$_d" hard_ceiling)" \
        "$(sess_get "$_d" soft_deadline)" \
        "$(sess_get "$_d" policy)" \
        "$(helper_probe_busy "$_d")" \
        "$_offac" \
        "$(sess_get "$_d" strikes)"
}

helper_finish() {
    _d=$1
    _reason=$2
    _id=$(sess_get "$_d" session_id)
    _started=$(sess_get "$_d" started_at)

    # Restore FIRST. A hung or broken hook must never be able to delay the
    # safety action (spec 9.3), and neither must a bookkeeping failure -- nor an
    # unreadable descriptor, which is one of the reasons this function is
    # called. Everything below reads the descriptor; this does not.
    if ! snap_restore; then
        macon_warn "restore reported a failure while ending the session ($_reason)"
    fi

    # Bookkeeping cannot fail the session: the restore above has already
    # happened, and this is the same close-out the CLI performs when `off` ends
    # a session the helper is not around to close.
    #
    # Both fields are checked because the descriptor may be gone: an id that is
    # not an identifier and a start that is not an epoch produce a half-empty
    # index row rather than a record of the night, and the row is worth less
    # than the warning that says why there is none.
    if _sess_is_name "$_id" && _sess_is_number "$_started"; then
        rec_close_session "$_id" "$_started" "$(macon_now)" "$_reason" ||
            macon_warn "session '$_id' ended ($_reason) but was not recorded"
    else
        macon_warn "a session ended ($_reason) but its descriptor was unreadable; not recorded"
    fi

    _hook=$(sess_get "$_d" hook_end)
    if [ -n "$_hook" ]; then
        # The reason is exported into the hook's own shell rather than
        # prefixed onto it: a prefix applies to the first command of the hook
        # only, and a hook is as likely to be a pipeline or a list as a single
        # command. The value is one of macon_decide's fixed literals.
        helper_run_as_user "$(sess_get "$_d" user)" "$MACON_HOOK_TIMEOUT" \
            "MACON_REASON=$_reason; export MACON_REASON; $_hook" >/dev/null 2>&1 || :
    fi

    rm -f "$(sess_desc_path)" "$(sess_pid_path)" "$(sess_heartbeat_path)" \
        "$(helper_offac_path)"
}

# When the display was last blanked. A plain variable, unlike the off-AC
# counter, because helper_wait is called directly by the loop rather than
# through a command substitution -- nothing here runs in a subshell whose
# assignments would be discarded. Should that ever change, the cost is one
# extra blank on a display that is already going dark.
_HELPER_LAST_BLANK=0

# Whether the lid already read shut at the previous look. The blank below is a
# LEVEL and the announcement is an EDGE, and this one bit of memory is the whole
# difference between them. It starts at 0 so a session armed with the lid
# already down announces at its first look, which is the right answer: the user
# has just typed the command and is closing the machine.
_HELPER_LID_CLOSED=0

# One look at the lid, feeding both watches, because the reading is the
# expensive part: this runs twice a second for a whole night, and asking ioreg
# the same question twice per cycle would double that for nothing.
helper_check_lid() {
    if ! plat_clamshell_closed; then
        _HELPER_LID_CLOSED=0
        return 0
    fi

    if [ "$_HELPER_LID_CLOSED" -eq 0 ]; then
        _HELPER_LID_CLOSED=1
        helper_announce "$1"
    fi

    helper_blank_display
}

# Put the display out when something has it lit under a shut lid.
#
# The condition is a LEVEL, not an edge: "the lid closed just now" would be
# cheaper to detect, but it is wrong. Verified on real hardware -- open and
# close the lid inside one cadence window and the flag never reads open, while
# macOS has meanwhile turned the panel back on. An edge sees no transition and
# leaves a fully lit screen under a closed lid, with nothing left to correct
# it. Asking what is true right now needs no memory and cannot miss a cycle it
# did not observe.
#
# This is cosmetic, not the safety invariant: a failed blank leaves a lit panel,
# never a Mac that cannot sleep. So the result is deliberately not checked --
# the next check retries a second later anyway, and the helper's stderr goes to
# /dev/null, so a warning per second would be noise nobody can read.
helper_blank_display() {
    plat_display_lit || return 0

    _now=$(macon_now)
    if [ "$_now" -lt "$(( _HELPER_LAST_BLANK + MACON_LID_GRACE ))" ]; then
        return 0
    fi
    _HELPER_LAST_BLANK=$_now

    plat_display_sleep_now || :
}

# A duration as something worth hearing rather than reading. The singulars are
# not politeness: `say` reads "1 hours" exactly as written, and the phrase is
# the only thing the user gets with the screen already dark.
helper_speakable_duration() {
    _sd_secs=$1
    _sess_is_number "$_sd_secs" || return 1

    _sd_h=$(( _sd_secs / 3600 ))
    _sd_m=$(( (_sd_secs % 3600) / 60 ))

    _sd_hw="hours"
    [ "$_sd_h" -eq 1 ] && _sd_hw="hour"
    _sd_mw="minutes"
    [ "$_sd_m" -eq 1 ] && _sd_mw="minute"

    if [ "$_sd_h" -gt 0 ] && [ "$_sd_m" -gt 0 ]; then
        printf '%s %s and %s %s\n' "$_sd_h" "$_sd_hw" "$_sd_m" "$_sd_mw"
    elif [ "$_sd_h" -gt 0 ]; then
        printf '%s %s\n' "$_sd_h" "$_sd_hw"
    elif [ "$_sd_m" -gt 0 ]; then
        printf '%s %s\n' "$_sd_m" "$_sd_mw"
    else
        printf 'less than a minute\n'
    fi
}

# Say that the session is holding, and for how much longer.
#
# "Mac on", two words, and not the tool's name: `say` reads "macon" as one word
# and pronounces it "mayken". The phrase is the only thing the user gets with
# the screen already dark, so it has to survive being heard rather than read.
#
# The ceiling rather than the soft deadline. It is the one bound no policy can
# move, so the number needs no branch here -- and under the default policy the
# two are the same instant anyway. With `--on-expire extend` the session may end
# before what is spoken; the soft deadline would be wrong in the other
# direction, and is a number the user cannot act on with the lid already shut.
#
# Every early return is silent. This is the last thing in the loop that may
# raise its voice about anything.
helper_announce() {
    _an_d=$1

    # Absence means announce. A descriptor written before this field existed
    # must not read as a silenced session, and the compare is a STRING compare
    # for the reason session.sh documents at length: an unexpected value in an
    # arithmetic context is not a false comparison on this shell, it is a fatal
    # error that takes the helper down with it.
    [ "$(sess_get "$_an_d" announce)" = "0" ] && return 0

    _an_user=$(sess_get "$_an_d" user)
    _sess_is_name "$_an_user" || return 0

    _an_ceiling=$(sess_get "$_an_d" hard_ceiling)
    _sess_is_number "$_an_ceiling" || return 0

    _an_left=$(( _an_ceiling - $(macon_now) ))
    [ "$_an_left" -lt 0 ] && _an_left=0

    plat_say_as_user "$_an_user" \
        "Mac on activated, $(helper_speakable_duration "$_an_left") remaining."
}

# How long the next pause lasts. A separate function because the interesting
# case cannot be reached through helper_wait without the suite actually waiting
# out the fallback: an unreadable interval arrives here as an empty string,
# which would make helper_wait's arithmetic an error rather than a wait. The
# floor is the shortest value a session is allowed to carry, so falling back to
# it cannot extend anything.
helper_wait_seconds() {
    if _sess_is_number "$1"; then
        printf '%s\n' "$1"
    else
        printf '%s\n' "$MACON_INTERVAL_FLOOR"
    fi
}

# The pause between polls, named rather than inlined so the suite can drive the
# loop at its own cadence. Stubbing sleep(1) itself would also silence
# macon_run_timeout's killer, which is the one thing in the loop that must keep
# working while the loop is under test.
#
# The pause is slept in slices so the lid can be watched at a human cadence
# without dragging the sampling interval down with it: a session samples
# thermals every 300s and looks at the lid every half second, from one loop.
#
# The bound is a deadline rather than a slice count, so a slow check cannot
# stretch the interval it is running inside.
helper_wait() {
    _until=$(( $(macon_now) + $(helper_wait_seconds "$1") ))
    while [ "$(macon_now)" -lt "$_until" ]; do
        helper_check_lid "$2"
        sleep "$MACON_LID_CADENCE"
    done
}

helper_loop() {
    _d=$1
    _warned=0
    while :; do
        _decision=$(helper_iterate "$_d")
        case "$_decision" in
            continue)
                _hook=$(sess_get "$_d" hook_warn)
                _pw=$(sess_get "$_d" pre_warn)
                if [ "$_warned" -eq 0 ] && [ -n "$_hook" ] && [ -n "$_pw" ] &&
                    [ "$(macon_now)" -ge $(( $(sess_get "$_d" soft_deadline) - _pw )) ]; then
                    _warned=1
                    helper_run_as_user "$(sess_get "$_d" user)" \
                        "$MACON_HOOK_TIMEOUT" "$_hook" >/dev/null 2>&1 || :
                fi
                ;;
            extend)
                _new=$(( $(sess_get "$_d" soft_deadline) + $(sess_get "$_d" extend_by) ))
                _ceil=$(sess_get "$_d" hard_ceiling)
                [ "$_new" -gt "$_ceil" ] && _new=$_ceil
                # Checked, because this rewrites the file the next poll reasons
                # from. sess_set replaces the descriptor rather than editing it,
                # and it refuses rather than installing a partial rewrite -- but
                # a descriptor this loop could not update is one it can no
                # longer keep a deadline in, and the extension it just granted
                # would be granted again at every poll for the rest of the
                # night. Ending is the direction the invariant points.
                if ! sess_set "$_d" soft_deadline "$_new"; then
                    macon_warn "could not extend the soft deadline; ending the session"
                    helper_finish "$_d" "descriptor-write-failed"
                    return 0
                fi
                _warned=0
                ;;
            end:*)
                helper_finish "$_d" "${_decision#end:}"
                return 0
                ;;
        esac
        helper_wait "$(sess_get "$_d" interval)" "$_d"
    done
}

# What launchd runs. It takes no arguments and reads only the root-owned copy
# `arm` installed, so a respawn can never be pointed at a file the user has
# replaced in the meantime.
#
# Three cases, and the first is the one that looks like a gap:
#
#   absent   -- nothing to resume. Exit 0, which KeepAlive's SuccessfulExit
#               false does not respawn, so the job goes quiet. This is also
#               every boot: /var/run is cleared, so the helper launchd starts at
#               load lands here, touches no power setting, writes no index row,
#               and therefore cannot collide with the boot failsafe.
#
#               "Settings applied, no descriptor" IS an orphan, and healing it
#               here is tempting. It must not, because at boot that state is
#               indistinguishable from this one. The case given up on -- a
#               descriptor deleted by hand on an armed machine -- is already
#               covered twice: cli_heal_orphan at the next macon command, and
#               the failsafe at the next boot.
#
#   valid    -- run the loop. A fresh arm and a respawn are indistinguishable on
#               purpose: everything the loop reasons from is absolute, so
#               resuming is simply running.
#
#   unusable -- restore and end. helper_finish restores FIRST, so a descriptor
#               nothing can read still gives the machine its sleep back.
helper_watch() {
    _w_d=$(sess_desc_path)

    [ -f "$_w_d" ] || return 0

    if ! helper_validate_desc "$_w_d"; then
        macon_warn "the session descriptor is not usable; restoring and ending"
        helper_finish "$_w_d" invalid-descriptor
        return 0
    fi

    printf '%s\n' "$$" > "$(sess_pid_path)"
    helper_loop "$_w_d"
}

if [ -z "${MACON_HELPER_SOURCED:-}" ]; then
    case "${1:-}" in
        # Run synchronously by the CLI under sudo, before launchd is told
        # anything. Spec 6.1 rule 3 lives here: fixed root code validates the
        # user-owned descriptor and takes its own copy, and the copy is the only
        # thing `watch` ever reads. A refusal here reaches the user's terminal
        # naming the offending field, instead of dying inside a launchd job
        # whose stderr nobody reads.
        arm)
            [ -n "${2:-}" ] || macon_die "usage: macon-helper arm DESCRIPTOR"
            helper_install_descriptor "$2" || macon_die "invalid session descriptor"
            helper_reset_counters
            ;;
        watch)
            helper_watch
            ;;
        *)
            macon_die "usage: macon-helper {arm DESCRIPTOR|watch}"
            ;;
    esac
fi
