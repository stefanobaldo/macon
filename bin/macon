#!/bin/sh
# macon -- short for mac overnight.
# Keep a Mac working with the lid closed, and guarantee the power
# configuration comes back.
#
# This is the unprivileged half of the tool. It parses, validates, and hands a
# descriptor to the root helper; it never runs the watch loop itself.
set -u

MACON_VERSION=0.1.0-rc.2

# The authoritative notice is LICENSE; this is the courtesy copy `macon version`
# prints, and a test asserts the two still agree. It is a separate string rather
# than something parsed out of LICENSE at run time because the installed CLI
# does not ship LICENSE beside it -- there would be nothing to read.
MACON_COPYRIGHT='Copyright (c) 2026 Stefano Baldo. MIT.'
MACON_LIB=${MACON_LIB:-/usr/local/libexec/macon/lib}
MACON_LIBEXEC=${MACON_LIBEXEC:-/usr/local/libexec/macon}
MACON_MIN_MACOS=13

# Longest numeric option accepted, in digits. Not hygiene: /bin/sh here is
# bash 3.2, whose `[ -lt ]` parses its operands into intmax_t and EXITS 2 on
# anything larger rather than returning false. An over-long value therefore
# does not fail a comparison, it makes the comparison fall through -- the guard
# stops guarding. lib/session.sh bounds the same class of value for the same
# reason.
MACON_MAX_DIGITS=18

# A session longer than a year is a typo, not a request. The bound exists so
# that the arithmetic building the deadlines stays far away from the overflow
# that would silently produce a ceiling in the past.
MACON_MAX_HOURS=8760

if [ -z "${MACON_CLI_SOURCED:-}" ]; then
    # shellcheck source=lib/common.sh
    . "$MACON_LIB/common.sh"
    # shellcheck source=lib/platform.sh
    . "$MACON_LIB/platform.sh"
    # shellcheck source=lib/decide.sh
    . "$MACON_LIB/decide.sh"
    # shellcheck source=lib/session.sh
    . "$MACON_LIB/session.sh"
    # shellcheck source=lib/snapshot.sh
    . "$MACON_LIB/snapshot.sh"
    # shellcheck source=lib/records.sh
    . "$MACON_LIB/records.sh"
    # shellcheck source=lib/report.sh
    . "$MACON_LIB/report.sh"
fi

# A plain decimal integer, bounded at both ends and with no leading zeros.
# The zeros matter as much as the magnitude: `[` reads them as decimal and
# $(( )) reads them as octal, so `030` would mean 30 to this guard and 24 to
# the deadline computed from it -- and `08` is not valid octal at all, which is
# a FATAL arithmetic error in a non-interactive shell rather than one this
# function could report.
cli_is_number() {
    case "$1" in
        '' | *[!0-9]*) return 1 ;;
        0) return 0 ;;
        0*) return 1 ;;
    esac
    [ "${#1}" -le "$MACON_MAX_DIGITS" ]
}

# Does this option have its value? Called with the remainder of the argument
# list, so `--max` at the end of the line is refused by name instead of read as
# an unset positional parameter -- which under `set -u` aborts the shell with a
# diagnostic nobody can act on.
cli_need_arg() {
    [ "$#" -ge 2 ] && return 0
    macon_warn "$1 requires a value"
    return 1
}

# Free-form option values become descriptor lines. A newline inside one lands
# as its own KEY=VALUE line, and the key worth forging is hard_ceiling. sess_set
# refuses to write such a value, but these fields are optional, so a refusal
# down there is a field that silently is not there; refused here, the message
# names the flag.
cli_is_single_line() {
    case "$2" in
        *'
'*)
            macon_warn "$1 cannot contain a newline"
            return 1
            ;;
    esac
    return 0
}

cli_usage() {
    cat <<'USAGE'
macon -- short for mac overnight

usage:
  macon on <hours> [options]      keep the Mac awake for <hours>
  macon run --max <hours> -- <cmd>
                                  keep it awake while <cmd> runs
  macon off                       restore power configuration now
  macon done [--grace N]          declare the work finished; macon restores
                                  at its next poll, no password needed
  macon status                    show the current state
  macon report [--out FILE] [--since DATE] [--session ID]
                                  render an HTML report of past sessions
  macon saved                     show the stored power snapshot
  macon log [--session ID]        show a session's raw samples
  macon failsafe {install|remove|status}
                                  install, remove or check the boot failsafe
  macon version                   print the version and licence
  macon help                      print this message (also --help, -h)

options for on and run:
  --max <hours>            hard ceiling (default: the requested duration;
                           required by run, which takes no duration of its own)
  --on-expire restore|extend   what to do at the soft deadline (default: restore)
  --extend-by <minutes>    extension step (default: 30)
  --busy-check <cmd>       completion predicate, run as you; exit 0 means busy
  --hook-end <cmd>         run after the restore, with MACON_REASON set
  --hook-warn <cmd>        run --pre-warn minutes before the soft deadline
  --pre-warn <minutes>     warning lead time (default: 15)
  --interval <seconds>     sampling interval (default: 300, floor 30)
  --allow-battery          allow starting on battery
  --no-failsafe            allow starting without the boot failsafe
  --no-announce            do not speak when the lid closes
  --quiet                  say nothing at all: implies --no-announce and
                           suppresses this command's own output (warnings,
                           errors and a wrapped command's output are kept)
USAGE
}

# Parses the options shared by `on` and `run`, publishing them as OPT_*.
#
# Those variables ARE the function's return value -- there is no other way for
# a POSIX shell function to hand back thirteen results -- which is why the
# unused-variable check is disabled for the whole function: every OPT_ here is
# an output, and its consumers are the subcommands below and the test suite.
# shellcheck disable=SC2034
cli_parse_on() {
    OPT_HOURS=""
    OPT_MAX=""
    OPT_POLICY=restore
    OPT_EXTEND_BY=30
    OPT_BUSY_CHECK=""
    OPT_HOOK_END=""
    OPT_HOOK_WARN=""
    OPT_PRE_WARN=15
    OPT_INTERVAL=300
    OPT_ALLOW_BATTERY=0
    OPT_NO_FAILSAFE=0
    OPT_ANNOUNCE=1
    OPT_QUIET=0
    OPT_WRAP=0
    # Not an option: no flag sets it. `run` fills it in with the process it
    # started, which is the one descriptor field that cannot be known until
    # after the command exists.
    OPT_WATCH_PID=""

    if [ "${1:-}" = "--wrap" ]; then
        OPT_WRAP=1
        shift
    else
        OPT_HOURS=${1:-}
        shift 2>/dev/null || :
        if ! cli_is_number "$OPT_HOURS"; then
            macon_warn "a duration in hours is required: macon on <hours>"
            return 1
        fi
        if [ "$OPT_HOURS" -lt 1 ] || [ "$OPT_HOURS" -gt "$MACON_MAX_HOURS" ]; then
            macon_warn "a duration must be between 1 and $MACON_MAX_HOURS hours"
            return 1
        fi
    fi

    while [ $# -gt 0 ]; do
        case "$1" in
            --max)           cli_need_arg "$@" || return 1; OPT_MAX=$2; shift 2 ;;
            --on-expire)     cli_need_arg "$@" || return 1; OPT_POLICY=$2; shift 2 ;;
            --extend-by)     cli_need_arg "$@" || return 1; OPT_EXTEND_BY=$2; shift 2 ;;
            --busy-check)    cli_need_arg "$@" || return 1; OPT_BUSY_CHECK=$2; shift 2 ;;
            --hook-end)      cli_need_arg "$@" || return 1; OPT_HOOK_END=$2; shift 2 ;;
            --hook-warn)     cli_need_arg "$@" || return 1; OPT_HOOK_WARN=$2; shift 2 ;;
            --pre-warn)      cli_need_arg "$@" || return 1; OPT_PRE_WARN=$2; shift 2 ;;
            --interval)      cli_need_arg "$@" || return 1; OPT_INTERVAL=$2; shift 2 ;;
            --allow-battery) OPT_ALLOW_BATTERY=1; shift ;;
            --no-failsafe)   OPT_NO_FAILSAFE=1; shift ;;
            --no-announce)   OPT_ANNOUNCE=0; shift ;;
            # --quiet is the superset: everything macon would have said, by
            # either channel. It implies --no-announce rather than living
            # beside it, because a flag named for silence that still speaks in
            # the dark is a promise broken in the one place nobody is watching.
            --quiet)         OPT_QUIET=1; OPT_ANNOUNCE=0; shift ;;
            *)               macon_warn "unknown option: $1"; return 1 ;;
        esac
    done

    case "$OPT_POLICY" in
        restore | extend) ;;
        *) macon_warn "--on-expire must be restore or extend"; return 1 ;;
    esac

    cli_is_single_line --busy-check "$OPT_BUSY_CHECK" || return 1
    cli_is_single_line --hook-end "$OPT_HOOK_END" || return 1
    cli_is_single_line --hook-warn "$OPT_HOOK_WARN" || return 1

    for _opt in "--extend-by:$OPT_EXTEND_BY" "--pre-warn:$OPT_PRE_WARN" \
        "--interval:$OPT_INTERVAL"; do
        if ! cli_is_number "${_opt#*:}"; then
            macon_warn "${_opt%%:*} must be a plain integer: '${_opt#*:}'"
            return 1
        fi
    done

    # Both bounds come from lib/session.sh rather than being restated here: the
    # descriptor is validated against those numbers, so a second copy would be
    # a second place for them to drift -- and drift here means the CLI accepts
    # what the helper then refuses, at arming time, with the message pointing
    # at a descriptor field instead of at the flag that set it.
    if [ "$OPT_INTERVAL" -lt "$MACON_INTERVAL_FLOOR" ]; then
        macon_warn "--interval has a floor of ${MACON_INTERVAL_FLOOR} seconds"
        return 1
    fi
    if [ "$OPT_INTERVAL" -gt "$MACON_INTERVAL_CEIL" ]; then
        macon_warn "--interval has a ceiling of ${MACON_INTERVAL_CEIL} seconds: every deadline is only checked at a poll"
        return 1
    fi

    _has_source=0
    [ -n "$OPT_BUSY_CHECK" ] && _has_source=1
    [ "$OPT_WRAP" -eq 1 ] && _has_source=1

    if [ "$OPT_POLICY" = "extend" ]; then
        if [ "$_has_source" -eq 0 ]; then
            macon_warn "--on-expire extend requires a source macon can poll (--busy-check, or run)"
            return 1
        fi
        if [ -z "$OPT_MAX" ]; then
            macon_warn "--on-expire extend requires an explicit --max"
            return 1
        fi
    fi

    if [ -z "$OPT_MAX" ]; then
        OPT_MAX=$OPT_HOURS
    fi
    # Still empty only under --wrap, where the ceiling is the caller's to
    # require; macon run refuses to start without one.
    if [ -n "$OPT_MAX" ]; then
        if ! cli_is_number "$OPT_MAX"; then
            macon_warn "--max must be a plain integer number of hours: '$OPT_MAX'"
            return 1
        fi
        if [ "$OPT_MAX" -lt 1 ] || [ "$OPT_MAX" -gt "$MACON_MAX_HOURS" ]; then
            macon_warn "--max must be between 1 and $MACON_MAX_HOURS hours"
            return 1
        fi
    fi
    if [ "$OPT_WRAP" -eq 0 ] && [ "$OPT_MAX" -lt "$OPT_HOURS" ]; then
        macon_warn "--max cannot be smaller than the requested duration"
        return 1
    fi

    return 0
}

# Where the boot failsafe is registered. Overridable so the tests can prove the
# refusal without a LaunchDaemon on the machine running them.
MACON_FS_PLIST=${MACON_FS_PLIST:-/Library/LaunchDaemons/local.macon.failsafe.plist}

# The label launchd knows the job by. Overridable alongside MACON_FS_PLIST so a
# test can ask about a job this machine does not have.
MACON_FS_LABEL=${MACON_FS_LABEL:-local.macon.failsafe}

# Has launchd actually loaded the boot failsafe?
#
# This question used to be answered everywhere by testing that the plist FILE
# exists, which reads like the same claim and is not: a plist can exist, parse,
# and still be a job launchd was never told about, or one it refused. The
# distinction is the whole point of the check -- it is what stands between a
# user and arming a session with no boot restore behind it.
#
# `launchctl print` is the probe because it answers from launchd rather than
# from the filesystem, and because it works unprivileged. Its exit status is the
# entire signal (0 loaded, 113 not), so nothing here parses its output, whose
# shape changes between macOS releases.
#
# It is still not proof the job would DO anything -- a loaded job can point at a
# program that exits immediately. It is strictly more than the file check was.
#
# One mechanism, not two. This used to carry a MACON_FS_LOADED=yes|no|launchd
# override of its own, from when the question was answered here rather than by
# the platform layer -- a test that wanted a loaded failsafe said `yes`, while a
# test that wanted a loaded HELPER daemon scripted the fake. Two dialects for
# one question, and the spec asks for the override to fold into the mechanism.
#
# There is nothing left for it to do. Every answer now comes from
# plat_launchd_loaded, and the suite replaces lib/platform.sh wholesale, so a
# test can no longer reach the real launchd by forgetting to set something: it
# scripts the label it is asking about, exactly as it does for the helper
# daemon, and an unscripted label is simply not loaded.
cli_failsafe_loaded() {
    plat_launchd_loaded "$MACON_FS_LABEL"
}

# Where the session helper's LaunchDaemon is registered, and the label launchd
# knows it by. Overridable for the same reason the failsafe's are: a test must
# be able to ask about a job this machine does not have.
MACON_HELPER_PLIST=${MACON_HELPER_PLIST:-/Library/LaunchDaemons/local.macon.helper.plist}
MACON_HELPER_LABEL=${MACON_HELPER_LABEL:-local.macon.helper}

# How long launchd waits between restarts of a job that keeps dying. It is
# launchd's own default, restated in the plist rather than left implicit,
# because it is the ENTIRE crash-loop bound this design relies on -- macon adds
# no give-up rule of its own -- and a reader of the plist should not have to
# know what launchd assumes.
MACON_HELPER_THROTTLE=10

# Has launchd loaded the session helper's daemon?
#
# Asked of launchd rather than of the filesystem, and the two are genuinely
# different claims: verified, a loaded job survives the deletion of its plist
# and keeps respawning, and a plist on disk may be one launchd was never told
# about. `macon on` refuses on this answer, so it has to be the real one.
cli_helper_daemon_loaded() {
    plat_launchd_loaded "$MACON_HELPER_LABEL"
}

# How long the ladder waits for the helper to report itself, in tenths of a
# second. It has to cover a sudo'd process starting; it must not be long enough
# that a user watches an armed machine with no watcher on it.
MACON_ARM_TRIES=${MACON_ARM_TRIES:-20}

cli_check_environment() {
    _major=$(plat_macos_major)
    if ! cli_is_number "$_major" || [ "$_major" -lt "$MACON_MIN_MACOS" ]; then
        macon_die "macOS $MACON_MIN_MACOS or later is required (found $(sw_vers -productVersion 2>/dev/null))"
    fi
}

# The invoking user's id, behind a function so the refusal below can be driven
# to its interesting branch by a suite that is not root -- the same gap
# plat_needs_sudo and helper_needs_sudo both work around by being pure
# predicates. A FUNCTION and not an environment variable, deliberately: a
# variable would be an override anyone could set under sudo to defeat the one
# check that exists to catch sudo.
cli_uid() {
    id -u
}

# Refuses a command that must not run as root, and says which command and why.
#
# Both call sites reach it for different reasons and a shared wording would be
# useless at either, so the command and the reason are arguments. It warns and
# returns rather than calling macon_die, for two reasons: the refusal is three
# lines rather than one, and a function that exits cannot be asserted on by a
# suite that has to survive calling it.
#
# The uid is a parameter, and it FAILS CLOSED. `[ "" -eq 0 ]` does not answer
# false, it errors and exits 2 -- so an unreadable uid would take the "not root"
# branch and allow exactly what this refuses. An empty $(id -u) is not
# hypothetical: a sanitised PATH with no id on it produces one. Ten digits is
# the whole range of a 32-bit uid_t. install.sh's install_check_not_root guards
# the same three shapes for the same reason.
cli_check_not_root() {
    case "$1" in
        '' | *[!0-9]*)
            macon_warn "could not read the current user id; refusing to run '$2'"
            return 1
            ;;
    esac
    if [ "${#1}" -gt 10 ]; then
        macon_warn "could not read the current user id; refusing to run '$2'"
        return 1
    fi
    [ "$1" -eq 0 ] || return 0
    macon_warn "do not run '$2' as root."
    macon_warn "$3"
    macon_warn "re-run it as yourself: macon runs sudo for the steps that need root."
    return 1
}

# Progress on stdout, unless --quiet asked for none.
#
# What it does NOT silence is the point. macon_warn and macon_die write to
# stderr and go through neither this nor anything like it, so every warning
# survives --quiet -- including the one that matters most, the rollback that did
# not fully succeed. Someone who asked for quiet asked for less chatter, not for
# a Mac that fails to restore without mentioning it.
#
# A function rather than a redirection of the whole command, because of `macon
# run`: the wrapped command inherits macon's stdout directly, so silencing the
# stream would swallow the output of the user's own job along with macon's.
#
# The default keeps `off`, `status` and the rest working: they never parse
# --quiet, so OPT_QUIET is unset for them and `set -u` would otherwise be fatal.
cli_out() {
    [ "${OPT_QUIET:-0}" -eq 1 ] && return 0
    # shellcheck disable=SC2059  # every format string here is this file's own
    printf "$@"
}

# Undoes whatever the ladder had managed to apply. The message matters as much
# as the call: a rollback that itself fails leaves the machine unable to sleep,
# and that is the one outcome the user has to be told about rather than left to
# discover at the airport.
cli_rollback() {
    macon_warn "$1; rolling back"
    if ! snap_restore; then
        macon_warn "THE ROLLBACK DID NOT FULLY SUCCEED -- this Mac may still be unable to sleep"
        macon_warn "check 'macon status', then run 'macon off'; the snapshot is in $(snap_path)"
    fi
}

# Removes run-directory files, escalating only if it has to. /var/run/macon is
# written by root, so a user cannot always clear it -- but the tests point
# MACON_RUN at a directory they own, and a sudo prompt inside a test suite is a
# hang, not a failure. Try unprivileged first and ask for a password only when
# something actually survived.
cli_remove_run_files() {
    rm -f "$@" 2>/dev/null || :
    for _f in "$@"; do
        if [ -e "$_f" ]; then
            sudo rm -f "$@" 2>/dev/null || :
            return 0
        fi
    done
}

# Settings applied, no live helper, heartbeat stale: the machine is holding a
# session nobody is watching, and nothing will end it -- the boot failsafe only
# fires at a boot. Restoring is the way back, and it is safe precisely because
# the orphan test already established there is no session to interrupt.
cli_heal_orphan() {
    _oid=$(sess_get "$(sess_desc_path)" session_id)
    _ostarted=$(sess_get "$(sess_desc_path)" started_at)
    if ! snap_restore; then
        macon_warn "the orphaned session could not be fully restored; check 'macon saved'"
    fi
    cli_remove_run_files "$(sess_desc_path)" "$(sess_pid_path)" "$(sess_heartbeat_path)"
    cli_record_end "$_oid" "$_ostarted" orphan
}

# Writes the index row for a session the helper is not around to close --
# ended by hand, or healed after its helper disappeared. Three of the spec's
# termination reasons have no other writer, and a night missing from the index
# is a night the report cannot show at all.
#
# Both fields are checked because they become columns: an empty start epoch is
# the truncated row that costs the index its sort key, and there is no useful
# row to write for a session nothing can name.
cli_record_end() {
    [ -n "$1" ] || return 0
    if ! cli_is_number "$2"; then
        macon_warn "session '$1' ended ($3) but its start time is unreadable; not recorded"
        return 0
    fi
    rec_close_session "$1" "$2" "$(macon_now)" "$3" ||
        macon_warn "session '$1' ended ($3) but was not recorded"
}

# The activation ladder. Order matters: everything that can fail without
# touching the machine happens first, and every mutation is followed
# immediately by a verification that can roll it back.
#
# DESCRIPTOR is a path the calling user can write; the helper takes its own
# root-owned copy on arrival.
cli_arm() {
    _d=$1

    # Step 1: the first mutation, and the one that matters. Nothing else is
    # attempted if it fails, so there is nothing to undo.
    if ! plat_pmset_disablesleep 1; then
        macon_warn "could not disable clamshell sleep"
        return 1
    fi

    # Only keys this machine actually has: pmset validates the whole key set
    # per invocation, so one key it does not know fails all of them. All of
    # them go in ONE call for the same reason -- applying them one at a time
    # passes through combinations pmset itself rejects.
    _apply=""
    for _k in sleep disksleep powernap; do
        [ -n "$(plat_pmset_read "$_k")" ] && _apply="$_apply $_k 0"
    done
    if [ -n "$_apply" ]; then
        # shellcheck disable=SC2086
        if ! plat_pmset_apply_ac $_apply; then
            cli_rollback "the sleep timers could not be zeroed"
            return 1
        fi
    fi

    # Step 2: hand the descriptor to the root helper. It validates it and takes
    # its own root-owned copy, and from then on that copy is the only thing the
    # daemon reads -- the user cannot move the ceiling once the session starts.
    #
    # Synchronous and checked, unlike the `nohup ... &` this replaces: a
    # descriptor this machine cannot use is refused here, on the user's
    # terminal, with the offending field named.
    #
    # After the pmset calls rather than before, which is the less friendly
    # order and the correct one. "A descriptor in /var/run means the machine is
    # armed" is what sess_orphaned rests on, and installing it first would also
    # leave a window in which a kickstart -- which any local account can issue --
    # finds a valid descriptor and starts a watch loop over an unarmed machine.
    #
    # It must own its own root context from the start: the sudo timestamp would
    # expire overnight and a rollback that needed a password would fail
    # silently.
    #
    # The library paths are restated through `env` because sudo's env_reset
    # drops them: verified, `MACON_LIB=probe sudo -n printenv MACON_LIB` prints
    # nothing and exits 1 while the same probe on PATH returns a value, so sudo
    # really did run. `sudo VAR=val cmd` is deliberately not used: that form
    # needs the setenv privilege in sudoers and errors without it.
    #
    # MACON_HELPER_CMD replaces the invocation wholesale, for the tests that
    # have to watch this fail. The descriptor path is in MACON_DESC.
    MACON_DESC=$_d
    export MACON_DESC
    _cmd=${MACON_HELPER_CMD:-}
    if [ -z "$_cmd" ]; then
        _cmd="sudo /usr/bin/env MACON_LIB=\"\$MACON_LIB\" MACON_LIBEXEC=\"\$MACON_LIBEXEC\" \
\"\$MACON_LIBEXEC/macon-helper\" arm \"\$MACON_DESC\""
    fi
    if ! eval "$_cmd"; then
        cli_rollback "the session descriptor was refused"
        cli_remove_run_files "$(sess_desc_path)"
        return 1
    fi

    # Step 3: tell launchd to start it. From here the daemon owns the process:
    # if it dies, KeepAlive brings it back and it resumes from the descriptor
    # installed above.
    #
    # A RELOAD rather than a kickstart, and the reason was measured rather than
    # assumed. `launchctl kickstart` on a loaded-but-idle job does not return
    # once the request is queued: it BLOCKS until ThrottleInterval has elapsed
    # since that job last started, then starts it and returns. Every path that
    # starts the daemon arms that clock -- install.sh bootstraps it, and `macon
    # off` re-registers it at the end of every session -- so `macon off`
    # followed by `macon on`, the most natural sequence a user types, sat
    # silently for the remainder of the window. Measured here: the wait is
    # exactly ten seconds minus the time since the last start, to within 40ms,
    # and zero once the window has passed.
    #
    # The throttle clock is per-LOAD, so booting the job out and bootstrapping
    # it again resets it. Measured from the same position: kickstart 10.04s, a
    # reload 30ms.
    #
    # It is also strictly more robust. On a job that is already running,
    # kickstart is a documented no-op -- the ladder below would then wait for a
    # helper that never starts and roll back with "no live helper appeared",
    # naming the wrong cause. A reload starts one either way.
    #
    # The bootout's status is deliberately unchecked. The job was loaded a
    # moment ago, when preflight asked, and 3/ESRCH -- the label is not loaded
    # -- is an ordinary answer rather than a failure. What has to succeed is the
    # bootstrap, and its failure leaves the job UNLOADED: the machine is still
    # restored below, and the next `macon on` refuses and names `macon off` as
    # the command that re-registers it.
    #
    # The pid file goes with the descriptor, like every failure below this
    # point. `arm` writes none, so today this clears nothing -- but a start
    # whose outcome is not known is one `watch` may still be reaching, and
    # `watch` writes the pid before it does anything else. Leaving one behind
    # would make sess_helper_alive report a session over a machine this branch
    # has just restored, which is the one wrong answer that matters.
    plat_launchd_bootout "$MACON_HELPER_LABEL" || :
    if ! plat_launchd_bootstrap "$MACON_HELPER_LABEL" "$MACON_HELPER_PLIST"; then
        cli_rollback "the helper daemon could not be started"
        cli_remove_run_files "$(sess_desc_path)" "$(sess_pid_path)"
        return 1
    fi

    # Step 4: verify. "Applied without a watcher" must not exist.
    #
    # Deleting the descriptor is what makes a failed arm self-terminating. The
    # job is still loaded and KeepAlive is still watching, so a helper that is
    # crash-looping will be respawned once more -- and with no descriptor to
    # read it takes helper_watch's first case, exits 0, and is not respawned
    # again. The loop stops itself; the CLI never has to fight launchd for it.
    _tries=0
    while [ "$_tries" -lt "$MACON_ARM_TRIES" ]; do
        if sess_helper_alive; then break; fi
        sleep 0.1 2>/dev/null || sleep 1
        _tries=$((_tries + 1))
    done

    if ! sess_helper_alive; then
        cli_rollback "no live helper appeared"
        cli_remove_run_files "$(sess_desc_path)" "$(sess_pid_path)"
        return 1
    fi

    if ! plat_sleep_disabled; then
        cli_rollback "disablesleep did not take effect"
        cli_remove_run_files "$(sess_desc_path)" "$(sess_pid_path)"
        return 1
    fi

    return 0
}

# Writes one descriptor field, fatally. sess_set refuses values it cannot
# represent, and most of these fields are optional -- so an unchecked write is
# a field that is silently absent, and absence is exactly what sess_validate
# cannot object to. A session that cannot be described is a session that does
# not start.
cli_desc_set() {
    sess_set "$1" "$2" "$3" ||
        macon_die "could not record '$2' in the session descriptor"
}

# The hand-over file. It is built where the calling user can write -- /var/run
# is root-owned -- and it is a DIFFERENT path from the helper's own copy on
# purpose: source and destination being the same file would make the helper's
# validate-then-copy a self-copy, and the tamper resistance it exists for
# (the user cannot move the ceiling once the session is running) would be
# bought with nothing.
cli_new_desc_path() {
    printf '%s/macon-session.%s.conf\n' "${TMPDIR:-/tmp}" "$$"
}

# Every guard that can refuse a session, before a single thing is mutated.
#
# Split out of cli_cmd_on for `macon run`, which has to get through all of this
# BEFORE it starts the command it wraps: a refusal arriving afterwards would
# leave that command running with nothing keeping the Mac awake for it, and
# every refusal here is a macon_die -- it exits, so there is no return path on
# which the caller could clean up.
cli_preflight() {
    # First, ahead of everything that mutates -- the orphan heal below included,
    # which restores. macon escalates per operation and is documented to be run
    # as yourself; run under sudo anyway, arming was not refused, and it went
    # wrong in two ways at once. The descriptor records `user` from $(id -un),
    # so it recorded root, and the helper de-privileges the user's --busy-check
    # and hooks by that name -- meaning it ran them as root, which is the one
    # thing the privilege split exists to prevent. And the power snapshot landed
    # in the user's own state directory owned by root, where it outlives the
    # session and the next unprivileged arm has to replace a file it does not
    # own.
    #
    # `run` arms too, so the verb is a parameter: a refusal that names a command
    # the user did not type is a refusal they have to translate.
    cli_check_not_root "$(cli_uid)" "${1:-macon on}" \
        "under sudo it records root as the session owner, so your --busy-check and hooks would run as root, and the power snapshot is left in your state directory owned by root." ||
        exit 1

    if sess_helper_alive; then
        macon_die "a session is already active; run 'macon off' first"
    fi

    if sess_orphaned; then
        macon_warn "healing an orphaned session before arming"
        cli_heal_orphan
    fi

    if [ "$(plat_power_source)" != "ac" ] && [ "$OPT_ALLOW_BATTERY" -eq 0 ]; then
        macon_die "not on AC power; lid closed with sleep disabled and no AC is the worst case this tool can produce (use --allow-battery to override)"
    fi

    # Both halves, because the file existing is not the same fact as launchd
    # having the job. Refusing is the safe direction: the cost of a false
    # refusal is a session that does not start and an escape hatch that is
    # named in the message, and the cost of a false pass is a machine that
    # reboots after a panic with disablesleep set and nothing left to clear it.
    if [ "$OPT_NO_FAILSAFE" -eq 0 ]; then
        if [ ! -f "$MACON_FS_PLIST" ]; then
            macon_die "the boot failsafe is not installed; run 'macon failsafe install' (or pass --no-failsafe)"
        fi
        if ! cli_failsafe_loaded; then
            macon_die "the boot failsafe is installed but launchd has not loaded it; run 'macon failsafe install' (or pass --no-failsafe)"
        fi
    fi

    # The session helper's daemon, with no escape hatch. --no-failsafe exists
    # because the boot failsafe has a defensible degraded mode; this one has
    # none -- there is no second way to start the helper, and adding a nohup
    # fallback would be a second arming path that nothing exercises until the
    # day it is the only one left.
    #
    # Asked of launchd, not of the plist file: a loaded job survives its plist
    # being deleted, and a plist on disk may be one launchd never accepted.
    if ! cli_helper_daemon_loaded; then
        # Both repairs, cheapest first. `macon off` re-registers the job on its
        # way out (cli_restore_helper_daemon), and the two ways to reach this
        # message with the plist still on disk -- someone unloaded the job by
        # hand, or an `off` died between its bootout and its bootstrap -- are
        # exactly what it fixes. Naming only the installer sends a user who
        # needs one command to fetch a tarball.
        macon_die "the macon helper daemon is not loaded; run 'macon off' to re-register it, or install.sh again if it is really gone -- 'macon on' cannot start a session with nothing supervising it"
    fi

    # And the plist, which is a SECOND fact and only became load-bearing when
    # arming started reloading the job instead of kickstarting it. A loaded job
    # outlives its plist file -- verified -- so a half-uninstalled machine
    # answers "loaded" above and has nothing to bootstrap from. Kickstart did
    # not care; a reload does.
    #
    # Refused here rather than discovered in cli_arm, because by then the power
    # settings are applied and the answer is a rollback the user reads as a
    # failure to start rather than as a macon that is half gone.
    if [ ! -f "$MACON_HELPER_PLIST" ]; then
        macon_die "the macon helper daemon is loaded but $MACON_HELPER_PLIST is gone; run install.sh again -- 'macon on' reloads the job from that file and cannot start a session without it"
    fi

    # Snapshotted on EVERY arm, not only when no snapshot exists.
    #
    # The endings differ in whether they consume the snapshot: `macon off` and
    # the boot failsafe delete it, while a session that reaches its deadline and
    # the orphan heal above both restore and leave it behind. So the automatic
    # endings -- the ordinary ones -- leave a snapshot that the next arm used to
    # reuse. A user who changed their power settings between two sessions had
    # those changes silently reverted when the second one ended, restoring
    # values that were correct for a night that is over.
    #
    # Re-reading is safe precisely because snap_save is not merely a write: it
    # refuses when snap_looks_active, which is the case this could otherwise get
    # wrong -- recording zeros as though they were someone's real configuration.
    # That guard is what makes "the machine is clean, so what it holds now IS
    # the value to restore to" a true statement rather than an assumption.
    #
    # It also tightens a case that used to pass: a modified machine that is not
    # an orphan (no live helper, but a heartbeat too fresh to declare one) used
    # to arm straight over the top, because a snapshot existed and nothing
    # looked again. It now refuses, which is the right direction for a machine
    # in a state macon cannot explain.
    #
    # One message per reason, because snap_save fails three ways and the answer
    # differs at each. Told about a modified machine, a user whose snapshot was
    # merely unwritable went looking for a session that was not there -- the
    # machine could sleep, `macon status` said `session: none`, and the message
    # described none of it.
    snap_save
    case $? in
        0) ;;
        1)
            macon_die "the machine already looks modified and no fresh snapshot could be taken; run 'macon off', or restore the values you want by hand and try again -- macOS exposes no defaults to reconstruct them"
            ;;
        2)
            macon_die "the current power values could not be read, so there is nothing safe to record as the original state; check that 'pmset -g custom' answers, and try again"
            ;;
        *)
            macon_die "the power snapshot could not be written to $(snap_path); check who owns that file and the directory holding it -- macon will not arm without a snapshot it just took"
            ;;
    esac
    cli_out 'saved original power state to %s\n' "$(snap_path)"

    # Announced only when the directory is still there. snap_backup_plists
    # creates the destination, fills it, then prunes to MACON_PMPREFS_KEEP -- so
    # with a retention of zero, which is a real request to keep none, the backup
    # just taken is itself in the excess, and printing the path it echoed named
    # a directory deleted microseconds earlier.
    #
    # Fixed here rather than there: the function's contract is that it echoes
    # the destination and reports whether a plist actually landed, and this is
    # the only caller that prints the path.
    #
    # Prefixed _pf_ because this function and snap_backup_plists both hold
    # variables across the call, and POSIX sh has no `local`.
    _pf_backup=$(snap_backup_plists)
    if [ -d "$_pf_backup" ]; then
        cli_out 'plist backup in %s\n' "$_pf_backup"
    fi
}

# Builds the hand-over descriptor from the OPT_* set cli_parse_on published, and
# arms. Returns non-zero if arming failed, having already rolled back.
#
# Shared by `on` and `run` rather than `run` re-entering through cli_cmd_on: the
# option list cannot be handed back to a parser in a POSIX shell without being
# flattened into a string first, and a re-parse would drop --wrap along with the
# completion source that makes `--on-expire extend` legal in the first place.
cli_start_session() {
    _id=$(macon_new_session_id)
    _now=$(macon_now)
    _d=$(cli_new_desc_path)
    # Created empty and tightened BEFORE anything is written into it: the
    # descriptor names the hooks and the busy-check, which are commands.
    : > "$_d" || macon_die "could not write a session descriptor in ${TMPDIR:-/tmp}"
    chmod 0600 "$_d" 2>/dev/null || :

    cli_desc_set "$_d" session_id "$_id"
    cli_desc_set "$_d" started_at "$_now"
    cli_desc_set "$_d" soft_deadline $((_now + OPT_HOURS * 3600))
    cli_desc_set "$_d" hard_ceiling $((_now + OPT_MAX * 3600))
    cli_desc_set "$_d" policy "$OPT_POLICY"
    cli_desc_set "$_d" extend_by $((OPT_EXTEND_BY * 60))
    cli_desc_set "$_d" pre_warn $((OPT_PRE_WARN * 60))
    cli_desc_set "$_d" interval "$OPT_INTERVAL"
    cli_desc_set "$_d" strikes 2
    cli_desc_set "$_d" user "$(id -un)"
    cli_desc_set "$_d" hook_end "$OPT_HOOK_END"
    cli_desc_set "$_d" hook_warn "$OPT_HOOK_WARN"
    cli_desc_set "$_d" busy_timeout 30
    cli_desc_set "$_d" announce "$OPT_ANNOUNCE"

    # The pull source: what macon ASKS at every poll. One of three, and the
    # sentinel is deliberately not among them -- it is a push channel, set
    # below for every session regardless of what is chosen here.
    #
    # A descriptor holds exactly one pull source, so the order here is a
    # precedence rule. The wrapped process comes first because it is the whole
    # of what `run` is -- but a flag the user typed and macon then ignored is
    # how a session ends at a time nobody asked for, so it is said out loud.
    if [ -n "$OPT_WATCH_PID" ]; then
        if [ -n "$OPT_BUSY_CHECK" ]; then
            macon_warn "ignoring --busy-check: 'macon run' watches the command it started"
        fi
        cli_desc_set "$_d" completion process
        cli_desc_set "$_d" watch_pid "$OPT_WATCH_PID"
    elif [ -n "$OPT_BUSY_CHECK" ]; then
        cli_desc_set "$_d" completion busy_check
        cli_desc_set "$_d" busy_check "$OPT_BUSY_CHECK"
    else
        cli_desc_set "$_d" completion none
    fi

    # The push channel, on every session without exception. This is what makes
    # `macon done` work whatever the pull source is, and what stops the caller
    # from having had to predict at arm time that they would want it.
    cli_desc_set "$_d" sentinel_path \
        "${MACON_STATE:-$HOME/.local/state/macon}/$_id.done"

    sess_validate "$_d" || macon_die "internal error: built an invalid session descriptor"

    _soft=$(sess_get "$_d" soft_deadline)
    _hard=$(sess_get "$_d" hard_ceiling)

    if ! cli_arm "$_d"; then
        rm -f "$_d"
        return 1
    fi
    # The helper works from its own copy from here on, so this one is not just
    # redundant, it is a second copy of the session's commands sitting in a
    # temporary directory.
    rm -f "$_d"

    cli_out 'armed until %s (ceiling %s)\n' \
        "$(date -r "$_soft" '+%H:%M')" \
        "$(date -r "$_hard" '+%H:%M')"
    cli_out 'safe to close the lid.\n'
    return 0
}

cli_cmd_on() {
    cli_check_environment
    cli_parse_on "$@" || exit 1
    cli_preflight
    cli_start_session || exit 1
}

# Stops the watch loop, and it is a BOOTOUT rather than a kill.
#
# Killing the pid stopped the old nohup'd helper. Under launchd it stops
# nothing: verified, `launchctl kill TERM` kills the process and KeepAlive
# respawns it within a tenth of a second, so the restore below would be racing a
# live watcher that keeps coming back. `bootout` is the only verb that stops a
# KeepAlive job -- verified: SIGTERM, the process is gone, the job is unloaded,
# and nothing respawns.
#
# It goes first and the restore follows, so no live helper is left fighting the
# restore -- but stopping is an attempt, not a guarantee. A bootout that fails
# leaves a helper that re-validates its descriptor at every poll; the run files
# are cleared AFTER the restore, so that helper reads a valid descriptor until
# the machine is safe and then finds it gone, ends itself, and exits 0. Which is
# why this warns rather than refusing.
cli_stop_helper() {
    plat_launchd_loaded "$MACON_HELPER_LABEL" || return 0

    if ! plat_launchd_bootout "$MACON_HELPER_LABEL"; then
        macon_warn "the helper daemon could not be stopped; restoring anyway"
        return 0
    fi

    _tries=0
    while [ "$_tries" -lt "$MACON_ARM_TRIES" ] && sess_helper_alive; do
        sleep 0.1 2>/dev/null || sleep 1
        _tries=$((_tries + 1))
    done
    if sess_helper_alive; then
        macon_warn "the helper is still running after the bootout; restoring anyway"
    fi
    return 0
}

# Puts the daemon back after `off` booted it out, so the next `macon on` finds a
# job to kickstart.
#
# Here rather than in `on`, so each command keeps one responsibility: `on`
# refuses when the daemon is missing, `off` puts it back. It doubles as a quiet
# repair -- an `off` run on a machine whose daemon someone unloaded by hand
# re-registers it.
#
# Nothing here can fail `off`. By the time this runs the machine has already
# been restored, so the only thing a failure costs is the next `on`, which will
# refuse and say why. Reporting it is the whole job.
cli_restore_helper_daemon() {
    if [ ! -f "$MACON_HELPER_PLIST" ]; then
        macon_warn "the helper daemon plist is missing ($MACON_HELPER_PLIST)"
        macon_warn "run install.sh again before the next 'macon on'"
        return 0
    fi
    plat_launchd_loaded "$MACON_HELPER_LABEL" && return 0
    plat_launchd_bootstrap "$MACON_HELPER_LABEL" "$MACON_HELPER_PLIST" ||
        macon_warn "the helper daemon could not be re-registered; run install.sh before the next 'macon on'"
    return 0
}

cli_cmd_off() {
    _d=$(sess_desc_path)
    # Every field read up front, before anything is undone, for the reason
    # helper_finish's own comment gives: the descriptor is deleted below.
    _id=$(sess_get "$_d" session_id)
    _started=$(sess_get "$_d" started_at)

    # The session's two files, cleared only when the descriptor named a usable
    # path. `${_sent%.done}.pending` on an empty field is the RELATIVE path
    # `.pending` -- and `off` on an idle machine, where every field reads empty,
    # is not an edge case but the command's ordinary use. Without this guard it
    # would hand `.pending` to rm in whatever directory the user typed it from.
    _sentpair=
    _sent=$(sess_get "$_d" sentinel_path)
    case "$_sent" in
        /*) _sentpair=yes ;;
    esac

    cli_stop_helper

    if snap_exists; then
        if snap_restore; then
            rm -f "$(snap_path)"
            printf 'power configuration restored.\n'
        else
            # A restore that failed has not consumed the snapshot, and macOS
            # cannot reconstruct what it holds. Deleting it here would destroy
            # the only record of the original values while the machine is still
            # holding the wrong ones.
            macon_warn "the restore did not fully succeed; the snapshot is kept in $(snap_path)"
            macon_warn "check 'macon status' before closing the lid again"
        fi
    else
        macon_warn "no snapshot in $(snap_path); only disablesleep can be cleared"
        macon_warn "if sleep/disksleep/powernap are zeroed, set them by hand:"
        macon_warn "  sudo pmset -c sleep <min> disksleep <min> powernap <0|1>"
        # Still worth running: it clears disablesleep, which is the half that
        # decides whether the lid can be closed at all.
        snap_restore || :
        printf 'clamshell sleep re-enabled.\n'
    fi

    # After the restore, for the reason cli_stop_helper explains.
    if [ -n "$_sentpair" ]; then
        cli_remove_run_files "$_d" "$(sess_pid_path)" "$(sess_heartbeat_path)" \
            "$_sent" "${_sent%.done}.pending"
    else
        cli_remove_run_files "$_d" "$(sess_pid_path)" "$(sess_heartbeat_path)"
    fi

    cli_restore_helper_daemon

    cli_record_end "$_id" "$_started" manual
}

# Generous on purpose. Being wrong in this direction costs two minutes of a
# machine staying awake; being wrong in the other costs the handoff the human
# wakes up to read. Under the default 300s poll it is usually invisible anyway
# -- the grace sets a floor, and the poll is normally what binds.
MACON_DONE_GRACE_DEFAULT=120

# The unprivileged counterpart to `macon off`. It needs no root: the helper is
# already root and already polling, so the whole job is to leave the file it is
# looking for. That asymmetry is the point -- at 03:00 the sudo timestamp has
# expired and an unattended caller has no tty to answer a prompt with, which is
# the same reason cli_start_session gives for the helper owning its own root
# context from the start.
cli_cmd_done() {
    # The uid goes through cli_uid and the check fails closed on an unreadable
    # one -- see the comment above cli_check_not_root; a bare
    # `[ "$(id -u)" -eq 0 ]` here is the shape that guard exists to stop.
    if ! cli_check_not_root "$(cli_uid)" 'macon done' \
        "it writes a file in your own state directory and needs no privilege"; then
        return 1
    fi

    _grace=$MACON_DONE_GRACE_DEFAULT
    while [ $# -gt 0 ]; do
        case $1 in
            --grace)
                if [ $# -lt 2 ]; then
                    macon_warn "--grace needs a number of seconds"
                    return 1
                fi
                # Through _sess_is_number rather than a second copy of its
                # bounds: bash 3.2 exits 2 rather than returning false on an
                # empty or over-long operand to `[ -ge ]`, and the grace
                # reaches exactly that comparison against the ceiling below.
                if ! _sess_is_number "$2"; then
                    macon_warn "--grace needs a whole number of seconds: '$2'"
                    return 1
                fi
                _grace=$2
                shift 2
                ;;
            *)  macon_warn "unknown argument: $1"
                return 1 ;;
        esac
    done

    _d=$(sess_desc_path)
    if [ ! -f "$_d" ]; then
        macon_warn "no session is armed; there is nothing to finish"
        return 1
    fi

    _sent=$(sess_get "$_d" sentinel_path)
    case "$_sent" in
        /*) ;;
        *)  macon_warn "this session carries no usable sentinel path"
            return 1 ;;
    esac

    if [ -e "$_sent" ]; then
        printf 'already marked finished; macon restores at its next poll.\n'
        return 0
    fi

    # Nothing is polling, so promising a restore would be false. Still worth
    # leaving the file: `macon status` reports it, and whoever heals the session
    # finds it already declared finished.
    if ! sess_helper_alive; then
        macon_warn "no live helper -- nothing is polling for this file"
        macon_warn "run 'macon status', and 'macon off' to restore by hand"
    fi

    if [ "$_grace" -eq 0 ]; then
        if ! printf 'done\n' > "$_sent"; then
            macon_warn "could not write $_sent"
            return 1
        fi
        printf 'marked finished.\n'
        printf 'macon restores at its next poll, within %ss.\n' \
            "$(sess_get "$_d" interval)"
        return 0
    fi

    _target=$(( $(macon_now) + _grace ))
    _pend="${_sent%.done}.pending"

    _ceil=$(sess_get "$_d" hard_ceiling)
    if _sess_is_number "$_ceil" && [ "$_target" -ge "$_ceil" ]; then
        macon_warn "the grace outlasts the hard ceiling; the session ends there first"
    fi

    # The target goes in the file, not in a variable only this process holds:
    # it is what lets `macon status` tell a countdown that is still running from
    # one whose child died, and a dead countdown that cannot be seen is worse
    # than one that never started.
    if ! printf '%s\n' "$_target" > "$_pend"; then
        macon_warn "could not write $_pend"
        return 1
    fi

    # Detached, so the grace runs alongside whatever the caller does next rather
    # than holding it still. Verified on this machine: a child spawned from an
    # agent's tool call outlives the call returning. nohup as well as & because
    # a background job in an interactive shell takes SIGHUP when the window
    # closes, and the spike only exercised a non-interactive one.
    #
    # Positional arguments rather than interpolation, so there is no quoting to
    # get wrong. mv is atomic within a filesystem and both files are siblings,
    # so the helper never sees a half-written sentinel.
    #
    # MACON_DONE_CMD replaces the launch wholesale, the way MACON_HELPER_CMD
    # does for the helper's: the suite must never wait on a real sleep.
    MACON_DONE_GRACE=$_grace
    MACON_DONE_PENDING=$_pend
    MACON_DONE_SENTINEL=$_sent
    export MACON_DONE_GRACE MACON_DONE_PENDING MACON_DONE_SENTINEL
    _cmd=${MACON_DONE_CMD:-}
    if [ -z "$_cmd" ]; then
        _cmd="nohup sh -c 'sleep \"\$1\"; mv -f \"\$2\" \"\$3\"' sh"
        _cmd="$_cmd \"\$MACON_DONE_GRACE\" \"\$MACON_DONE_PENDING\""
        _cmd="$_cmd \"\$MACON_DONE_SENTINEL\" >/dev/null 2>&1 &"
    fi
    eval "$_cmd"

    printf 'marked finished; the sentinel lands at %s (%ss from now).\n' \
        "$(date -r "$_target" '+%H:%M')" "$_grace"
    printf 'macon restores at its next poll after that, within %ss.\n' \
        "$(sess_get "$_d" interval)"
    return 0
}

_cli_row() {
    printf '%-17s %s\n' "$1" "$2"
}

cli_cmd_status() {
    # First, because this output is what the bug report template asks a user to
    # paste and the version is the first thing anyone reading it needs. It was
    # missing: a report could say exactly what went wrong without saying which
    # macon it went wrong in.
    _cli_row "version:" "$MACON_VERSION"

    if plat_sleep_disabled; then
        _cli_row "clamshell sleep:" "DISABLED (safe to close the lid)"
    else
        _cli_row "clamshell sleep:" "active (closing the lid suspends)"
    fi
    _cli_row "battery:" "$(plat_battery_pct)%"
    _cli_row "power source:" "$(plat_power_source)"
    _cli_row "ac sleep/disk/np:" \
        "$(plat_pmset_read sleep) / $(plat_pmset_read disksleep) / $(plat_pmset_read powernap)"

    if sess_helper_alive; then
        _d=$(sess_desc_path)
        _soft=$(sess_get "$_d" soft_deadline)
        if cli_is_number "$_soft"; then
            _left=$(( _soft - $(macon_now) ))
            [ "$_left" -lt 0 ] && _left=0
            _cli_row "session:" "active, $((_left / 3600))h$(( (_left % 3600) / 60 ))m to the soft deadline"
        else
            _cli_row "session:" "active, with an unreadable deadline"
        fi
        _cli_row "policy:" "$(sess_get "$_d" policy) / completion: $(sess_get "$_d" completion)"

        # The push channel's state, and the only place the path is named --
        # `macon on` stopped printing it, and the FILE is still the contract for
        # a consumer that cannot exec macon.
        #
        # Parsed HERE and nowhere else: `macon status` is unprivileged, and the
        # root helper tests the sentinel's existence and never reads either
        # file's contents (BRIEFING.md section 4).
        # The absoluteness is checked before the path is USED, not merely
        # reported: `${_sent%.done}.pending` on an empty field is `.pending`,
        # a relative path that would be tested against whatever directory the
        # caller happened to be standing in. helper_validate_desc refuses such
        # a descriptor, so this is the case where a session is already ending
        # -- which is exactly when a status must not start inventing rows.
        _sent=$(sess_get "$_d" sentinel_path)
        case "$_sent" in
            /*)
                _pend="${_sent%.done}.pending"
                if [ -e "$_sent" ]; then
                    _cli_row "finish:" "marked finished -- restoring at the next poll"
                elif [ -f "$_pend" ]; then
                    _t=$(head -1 "$_pend" 2>/dev/null)
                    if _sess_is_number "$_t" && [ "$_t" -gt "$(macon_now)" ]; then
                        _cli_row "finish:" "finishing at $(date -r "$_t" '+%H:%M')"
                    else
                        # The target is past -- or unreadable, which tells us no
                        # more -- and no sentinel arrived, so the child that was
                        # going to write one is gone. Saying nothing here would
                        # let the reader believe a countdown is still running.
                        _cli_row "finish:" \
                            "countdown lost -- nothing will write the sentinel"
                    fi
                fi
                _cli_row "sentinel:" "$_sent"
                ;;
            *)  _cli_row "sentinel:" "none -- this descriptor carries no usable path"
                ;;
        esac
    elif sess_orphaned; then
        # Reported, never healed: a read command stays a read command. A status
        # that quietly restored would erase the state it is describing.
        _cli_row "session:" "ORPHANED -- settings applied with no live helper"
        printf "run 'macon off' to restore.\n"
    else
        _cli_row "session:" "none"
    fi

    if [ ! -f "$MACON_FS_PLIST" ]; then
        _cli_row "boot failsafe:" "absent"
    elif cli_failsafe_loaded; then
        _cli_row "boot failsafe:" "installed"
    else
        _cli_row "boot failsafe:" "NOT LOADED -- it will not run at boot"
    fi

    # Two sources, with a deliberate line between them. Whether the job is
    # loaded comes from the EXIT STATUS of `launchctl print` and nothing else:
    # the shape of that output changes between macOS releases, and this is the
    # fact `macon on` refuses on. The state and the run count are parsed, so
    # they are best-effort by construction -- a reading that does not parse is
    # simply not shown, and the row degrades to the half that is load-bearing.
    #
    # `runs` is launchd's own start counter and the entire respawn diagnostic:
    # macon keeps none of its own. It is reported RAW, with no threshold, and
    # that is a measurement rather than a preference.
    #
    # Across the sequence macon produces: install.sh bootstraps and the job runs
    # once and exits 0 (runs=1); `macon on` RELOADS the job, which resets the
    # counter and starts it (runs=1 again); each crash adds one; `macon off`
    # boots out and re-bootstraps, back to 1. A healthy session therefore sits
    # at ONE, and a session showing more has been respawned -- which is exactly
    # what this row exists to say.
    #
    # It read TWO until arming stopped kickstarting the job and started
    # reloading it, and the baseline moved because the counter is launchd's and
    # resets on load. That is the whole reason the number is printed rather than
    # judged: a "greater than one means trouble" rule written against the old
    # sequence would have fired every single night, and any rule written against
    # this one is one stop-sequence change away from doing the same.
    if ! cli_helper_daemon_loaded; then
        _cli_row "helper daemon:" "NOT LOADED -- 'macon on' will refuse"
    else
        case "$(plat_launchd_state "$MACON_HELPER_LABEL")" in
            running) _hd="loaded, running" ;;
            'not running') _hd="loaded, idle" ;;
            *) _hd="loaded" ;;
        esac
        _hruns=$(plat_launchd_runs "$MACON_HELPER_LABEL")
        if cli_is_number "$_hruns"; then
            _hd="$_hd (runs: $_hruns)"
        fi
        _cli_row "helper daemon:" "$_hd"
    fi

    _last=$(rec_sessions 0 | head -1)
    if [ -n "$_last" ]; then
        _cli_row "last session:" \
            "$(printf '%s' "$_last" | cut -f4), worst thermal $(printf '%s' "$_last" | cut -f5)"
    fi
}

cli_cmd_saved() {
    if snap_exists; then
        printf 'snapshot (%s):\n' "$(snap_path)"
        sed 's/^/  /' "$(snap_path)"
        printf "'macon off' will apply: pmset -a disablesleep 0; pmset -c %s\n" \
            "$(snap_restore_args)"
    else
        printf 'no snapshot -- nothing was modified, or macon off already ran.\n'
    fi
}

cli_cmd_log() {
    _id=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --session) cli_need_arg "$@" || exit 1; _id=$2; shift 2 ;;
            -*)        macon_die "unknown option: $1" ;;
            *)         _id=$1; shift ;;
        esac
    done

    if [ -z "$_id" ]; then
        _id=$(rec_sessions 0 | head -1 | cut -f1)
    fi
    [ -n "$_id" ] || macon_die "no sessions recorded yet"

    # The id becomes a path, and this one was typed on the command line. The
    # records module refuses what it cannot use as a filename.
    _p=$(rec_samples_path "$_id") || macon_die "'$_id' is not a usable session id"
    [ -f "$_p" ] || macon_die "no samples for session $_id"
    cat "$_p"
}

# Picks the document. Split out of the parser so that the same call can be made
# once, either to stdout or into a file, without the redirection being written
# twice.
cli_report_render() {
    if [ -n "$1" ]; then
        rep_session_html "$1"
    else
        rep_html "$2"
    fi
}

# The read-only half of the tool: it renders what past sessions recorded and
# mutates nothing -- no power settings, no run directory, not even the records.
cli_cmd_report() {
    _out=""
    _since=0
    _sid=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --out)     cli_need_arg "$@" || exit 1; _out=$2; shift 2 ;;
            --since)   cli_need_arg "$@" || exit 1; _since=$2; shift 2 ;;
            --session) cli_need_arg "$@" || exit 1; _sid=$2; shift 2 ;;
            *)         macon_die "unknown option: $1" ;;
        esac
    done

    _epoch=$(rep_since_epoch "$_since") ||
        macon_die "--since takes a date (YYYY-MM-DD) or a Unix epoch: '$_since'"

    # The id becomes a path, and this one was typed on the command line. Checked
    # HERE rather than left to rep_session_html: with --out, the redirection
    # truncates the destination before the renderer runs, so a refusal down
    # there costs the user the report that was already in the file.
    if [ -n "$_sid" ]; then
        rec_samples_path "$_sid" >/dev/null ||
            macon_die "'$_sid' is not a usable session id"
        # A flag the user typed and macon then ignored is worse than a refusal.
        [ "$_since" = "0" ] ||
            macon_warn "ignoring --since: --session renders one session's samples"
    fi

    if [ -n "$_out" ]; then
        cli_report_render "$_sid" "$_epoch" > "$_out" ||
            macon_die "could not write the report to $_out"
        printf 'report written to %s\n' "$_out"
    else
        cli_report_render "$_sid" "$_epoch"
    fi
}

# Where this user's snapshot and records live. The same expression the library
# modules default to, restated here because the CLI needs the value itself --
# to name it in the LaunchDaemon's environment.
cli_state_dir() {
    printf '%s\n' "${MACON_STATE:-$HOME/.local/state/macon}"
}

# XML text, not markup: a path is data, and an unescaped & or < makes the plist
# unparseable. launchd's response to a plist it cannot parse is to not run the
# job -- which for this job means no boot restore at all, discovered on the
# morning it was needed.
cli_xml_escape() {
    printf '%s' "$1" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'
}

# One <key><string> pair for the job's environment, or nothing when the value
# is empty. The value is XML text, not markup: see cli_xml_escape.
cli_plist_env_entry() {
    [ -n "$2" ] || return 0
    printf '    <key>%s</key><string>%s</string>\n' "$1" "$(cli_xml_escape "$2")"
}

# Renders the LaunchDaemon. PROGRAM is the failsafe; STATE_DIR, LIB_DIR and
# LIBEXEC_DIR, when given, are written into the job's environment.
#
# Those arguments are what makes the boot restore work at all. launchd starts a
# system daemon with NO user context and NO inherited environment, so every
# path the job depends on has to be stated here:
#
#   MACON_STATE   -- the snapshot's default location is under the invoking
#                    user's home, which resolves to nothing for a system
#                    daemon. The failsafe can search for a snapshot itself, but
#                    on a multi-user Mac that search picks the most recently
#                    written one, which is a guess. Naming the directory leaves
#                    the search as the safety net it was meant to be.
#   MACON_LIB     -- libexec/failsafe.sh defaults it to /usr/local, and sources
#                    four libraries from it before it reaches its first log
#                    line. Installed under any other prefix, an unnamed
#                    MACON_LIB is a boot job that dies silently while `macon
#                    status` still reports the failsafe as installed -- the
#                    machine looks protected and is not.
#   MACON_LIBEXEC -- for the same reason, ahead of the day the failsafe needs
#                    to reach a sibling component.
cli_failsafe_plist() {
    _prog=$(cli_xml_escape "$1")
    _entries=$(
        cli_plist_env_entry MACON_STATE "${2:-}"
        cli_plist_env_entry MACON_LIB "${3:-}"
        cli_plist_env_entry MACON_LIBEXEC "${4:-}"
    )
    _env=""
    if [ -n "$_entries" ]; then
        _env=$(printf '  <key>EnvironmentVariables</key>\n  <dict>\n%s\n  </dict>' \
            "$_entries")
    fi
    cat <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>local.macon.failsafe</string>
  <key>RunAtLoad</key><true/>
  <key>ProgramArguments</key>
  <array><string>$_prog</string></array>
${_env}
</dict>
</plist>
PLIST
}

# Renders the session helper's LaunchDaemon.
#
# Deliberately a second function rather than a shared renderer with
# cli_failsafe_plist. The two jobs differ in exactly the keys that make them
# different jobs -- one runs once at boot and exits, the other lives for a
# session and must not die -- so a shared renderer would take those as
# parameters and be a template engine for two documents. Six lines of XML
# envelope is the cheaper duplication.
#
# KeepAlive is a DICT with SuccessfulExit false, and that single key is the
# whole contract of this change:
#
#   - an abnormal death (crash, kill -9, OOM) respawns, and the new instance
#     re-reads the root-owned descriptor and resumes the session;
#   - `exit 0` does NOT respawn -- and `exit 0` is what the helper does both
#     when a session ends and when there is no session to run.
#
# A bare <true/> would restart the helper for ever after every clean ending.
# Verified in both directions on the real machine.
#
# No RunAtLoad: KeepAlive already starts the job when launchd loads it.
#
# The environment is not decoration. Verified: a launchd system daemon gets
# PATH=/usr/bin:/bin:/usr/sbin:/sbin and NOTHING else -- no HOME, no USER, no
# TMPDIR, no tty. MACON_STATE in particular is where the snapshot lives, and
# lib/snapshot.sh otherwise falls back to a $HOME this job does not have; the
# old `sudo nohup` launch passed the user's HOME through, which is the only
# reason that fallback ever worked.
cli_helper_plist() {
    _prog=$(cli_xml_escape "$1")
    _entries=$(
        cli_plist_env_entry MACON_STATE "${2:-}"
        cli_plist_env_entry MACON_LIB "${3:-}"
        cli_plist_env_entry MACON_LIBEXEC "${4:-}"
    )
    _env=""
    if [ -n "$_entries" ]; then
        _env=$(printf '  <key>EnvironmentVariables</key>\n  <dict>\n%s\n  </dict>' \
            "$_entries")
    fi
    cat <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$MACON_HELPER_LABEL</string>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>$MACON_HELPER_THROTTLE</integer>
  <key>ProgramArguments</key>
  <array><string>$_prog</string><string>watch</string></array>
${_env}
</dict>
</plist>
PLIST
}

# Splits `macon run [opts] -- cmd...` at the separator and validates that the
# shape is there at all.
#
# WRAP_OPTS and WRAP_CMD are DISPLAY values, and nothing acts on either: joining
# arguments with spaces cannot represent one that contains a space, so a string
# rebuilt from `--busy-check 'pgrep -qf my daemon'` is four arguments where the
# user gave two. The option list is re-derived from the real positional
# parameters by cli_run_parse and the command by cli_cmd_run, each of which
# still has them.
#
# shellcheck disable=SC2034
cli_split_wrap_args() {
    WRAP_OPTS=""
    WRAP_CMD=""
    _seen=0
    while [ $# -gt 0 ]; do
        if [ "$_seen" -eq 0 ] && [ "$1" = "--" ]; then
            _seen=1
            shift
            continue
        fi
        if [ "$_seen" -eq 0 ]; then
            WRAP_OPTS="$WRAP_OPTS $1"
        else
            WRAP_CMD="$WRAP_CMD $1"
        fi
        shift
    done
    WRAP_OPTS=${WRAP_OPTS# }
    WRAP_CMD=${WRAP_CMD# }

    if [ "$_seen" -eq 0 ]; then
        macon_warn "macon run requires a -- separator: macon run [options] -- <command>"
        return 1
    fi
    if [ -z "$WRAP_CMD" ]; then
        macon_warn "no command given after --"
        return 1
    fi
    return 0
}

# Parses the options that precede `--`, from the arguments themselves.
#
# A shell function cannot hand a sublist back to its caller, so the list is
# rotated instead: the leading options are moved to the end, the wrapped command
# is shifted away, and what is left is exactly the options -- still as separate
# arguments, spaces and all. This function has its own $@, so the caller's
# survives the rotation and still carries the command.
cli_run_parse() {
    _n=0
    for _a in "$@"; do
        [ "$_a" = "--" ] && break
        _n=$((_n + 1))
    done

    _i=0
    while [ "$_i" -lt "$_n" ]; do
        _a=$1
        shift
        set -- "$@" "$_a"
        _i=$((_i + 1))
    done
    shift $(( $# - _n ))

    cli_parse_on --wrap "$@"
}

# The wrapped process, and whether a session was ever armed for it. The traps
# below read both.
MACON_WRAP_PID=""
MACON_WRAP_ARMED=0

# A `macon run` that dies before arming -- including through macon_die, which
# exits rather than returning -- must not leave the command it started running
# with nothing watching over it. Once the session is armed this is deliberately
# a no-op: from then on the command is the user's business and macon's job is
# only to keep the machine awake for it.
cli_run_cleanup() {
    [ "$MACON_WRAP_ARMED" -eq 1 ] && return 0
    [ -n "$MACON_WRAP_PID" ] || return 0
    macon_warn "stopping the wrapped command: no session was armed for it"
    macon_kill_group "$MACON_WRAP_PID"
    wait "$MACON_WRAP_PID" 2>/dev/null || :
}

# Ctrl-C has to reach the command as well. Job control puts it in a process
# group of its own, which is what lets the cleanup above take down the tree --
# and is also what stops the terminal's own signal from ever getting there.
cli_run_interrupt() {
    [ -n "$MACON_WRAP_PID" ] && macon_kill_group "$MACON_WRAP_PID"
    exit 130
}

cli_cmd_run() {
    cli_check_environment
    cli_split_wrap_args "$@" || exit 1
    cli_run_parse "$@" || exit 1

    # `run` takes no positional duration, so the ceiling is the only bound the
    # session can have -- and a session with no bound is the one thing this tool
    # must never start.
    if [ -z "$OPT_MAX" ]; then
        macon_die "macon run requires --max <hours> as the hard ceiling"
    fi
    OPT_HOURS=$OPT_MAX

    # Everything that can refuse, before the command exists.
    cli_preflight 'macon run'

    # Drop the options and the separator; what remains is the command, still as
    # the arguments the user actually typed. Running it through `sh -c` on a
    # flattened string would put them through a second round of splitting and
    # expansion: `macon run -- grep 'a b' f` would search for `a`, and a `;`
    # inside an argument would stop being data.
    while [ $# -gt 0 ] && [ "$1" != "--" ]; do shift; done
    shift

    trap cli_run_cleanup EXIT
    trap cli_run_interrupt INT TERM

    # Its own process group, so the cleanup path can take down what the command
    # has already spawned instead of orphaning a tree under a session that never
    # started. stdin is /dev/null explicitly: `run` is for unattended work, and
    # with a controlling terminal a background read would be a SIGTTIN and a job
    # stopped for as long as the ceiling allows.
    case $- in
        *m*) _mon=1 ;;
        *) _mon=0 ;;
    esac
    set -m
    "$@" < /dev/null &
    MACON_WRAP_PID=$!
    [ "$_mon" -eq 1 ] || set +m

    OPT_WATCH_PID=$MACON_WRAP_PID
    cli_start_session || exit 1
    MACON_WRAP_ARMED=1

    cli_out 'watching pid %s; the session ends when it exits.\n' "$MACON_WRAP_PID"
    wait "$MACON_WRAP_PID"
    _rc=$?
    printf 'the wrapped command exited with %s\n' "$_rc"
    exit "$_rc"
}

# The plist this machine should have: the installed failsafe, the state
# directory of the user installing it, and the library paths this CLI is
# itself using -- which are the installed ones, since `install.sh` sets both
# when it calls this. Separate from the install verb so what would be written
# can be asserted without a test suite that registers a boot-time root daemon.
cli_failsafe_plist_for_install() {
    cli_failsafe_plist "$MACON_LIBEXEC/failsafe.sh" "$(cli_state_dir)" \
        "$MACON_LIB" "$MACON_LIBEXEC"
}

# The plist this machine should have. Separate from any install verb for the
# same reason cli_failsafe_plist_for_install is: what would be written can be
# asserted without a test suite that registers a boot-time root daemon.
cli_helper_plist_for_install() {
    cli_helper_plist "$MACON_LIBEXEC/macon-helper" "$(cli_state_dir)" \
        "$MACON_LIB" "$MACON_LIBEXEC"
}

# Everything that makes removing the boot failsafe unsafe right now, as a word
# list.
#
# Deliberately the same three conditions, in the same three words, that
# install.sh and uninstall.sh already refuse on. This verb is what uninstall.sh
# calls to perform the removal, so a second dialect here would be a second
# answer to the same question -- and the project's own policy is already stated
# on the other side of it: cli_preflight refuses to ARM a session without the
# failsafe.
#
# The third word is the DESCRIPTOR, not the snapshot, and the two sides of that
# have to agree because they meet on one path. A snapshot outlives every session
# that ends by itself -- the ordinary ending -- since macon re-snapshots on each
# arm rather than reverting a user to values that were correct for a night
# already over; and it is the only record of the original values, because macOS
# exposes no readable power defaults, which is a reason to keep it rather than
# to refuse over it. Refusing here over one, while uninstall.sh no longer
# refuses over the same file, produced the worst message this tool can print: a
# full "this Mac may be left unable to sleep" warning naming two commands to
# run, printed into an uninstall that swallowed the failure, removed the plist
# itself and reported success -- with the escape hatch it named pointing at a
# binary that was about to stop existing.
#
# The descriptor is the fact that actually brackets a session: on disk before
# launchd is asked to start the helper, unlinked only after the restore has run.
cli_failsafe_blockers() {
    _b=""
    sess_helper_alive && _b="$_b session"
    plat_sleep_disabled && _b="$_b sleep-disabled"
    [ -f "$(sess_desc_path)" ] && _b="$_b descriptor"
    printf '%s\n' "${_b# }"
}

cli_explain_failsafe_blockers() {
    macon_warn "refusing to remove the boot failsafe -- this Mac may be left unable to sleep:"
    # Intentionally unquoted: $1 is the word list cli_failsafe_blockers built.
    # shellcheck disable=SC2086
    for _r in $1; do
        case "$_r" in
            session)
                macon_warn "  - a session is still running ($(sess_pid_path))" ;;
            sleep-disabled)
                macon_warn "  - clamshell sleep is DISABLED right now" ;;
            descriptor)
                macon_warn "  - a session descriptor is present: $(sess_desc_path)" ;;
        esac
    done
    macon_warn "the boot failsafe is the only thing that clears disablesleep after a"
    macon_warn "panic or a power loss. Removed now, the next reboot leaves this Mac"
    macon_warn "unable to sleep with nothing left to undo it."
    macon_warn "run 'macon off' first, then remove it. To remove it anyway:"
    macon_warn "  macon failsafe remove --force"
    return 0
}

cli_cmd_failsafe() {
    case "${1:-status}" in
        install)
            # Ahead of the first sudo, and for the reason install.sh refuses a
            # root installer: the plist this writes names MACON_STATE, and it
            # reads that value from its OWN environment -- but sudo DISCARDS an
            # exported MACON_STATE. Registered under sudo, the boot failsafe
            # therefore looks for the snapshot in the default state directory
            # rather than the configured one, at the one moment it is the only
            # thing left that can restore the machine. Dropping back to
            # SUDO_USER cannot recover the value either; it is already gone.
            #
            # Before the sudo rather than after: a refusal that arrives once the
            # password has been typed has already cost the user the password.
            cli_check_not_root "$(cli_uid)" 'macon failsafe install' \
                "sudo discards an exported MACON_STATE, so the boot failsafe would be registered against the default state directory instead of yours." ||
                exit 1

            # Through a temporary file rather than `render | sudo tee`, which
            # reports TEE's status and not the renderer's: a render that died
            # halfway left the pipeline exiting 0 over a truncated root-owned
            # plist, chown and chmod both succeeded on it, and what stayed on
            # the machine was a file launchd fails to parse at every boot.
            # install.sh had this fixed; this verb writes the same document and
            # still had the pipe. `plutil -lint` is the check for the same
            # reason it is there: it catches a truncated render, which a test
            # for a non-empty file does not.
            #
            # The temporary file is the user's own, 0600 from mktemp, cleared
            # through a trap so an interrupt cannot leave one behind, and
            # copied rather than moved so the destination is root's from the
            # start.
            _fs_tmp=$(mktemp "${TMPDIR:-/tmp}/macon-failsafe-plist.XXXXXX") ||
                macon_die "could not create a temporary file for the failsafe plist"
            trap 'rm -f "$_fs_tmp"' EXIT HUP INT TERM
            _fs_ok=1
            cli_failsafe_plist_for_install > "$_fs_tmp" || _fs_ok=0
            [ "$_fs_ok" -eq 1 ] && { plutil -lint "$_fs_tmp" >/dev/null 2>&1 || _fs_ok=0; }
            [ "$_fs_ok" -eq 1 ] && { sudo cp "$_fs_tmp" "$MACON_FS_PLIST" || _fs_ok=0; }
            rm -f "$_fs_tmp"
            trap - EXIT HUP INT TERM
            [ "$_fs_ok" -eq 1 ] ||
                macon_die "the boot failsafe plist could not be written to $MACON_FS_PLIST"
            sudo chown root:wheel "$MACON_FS_PLIST"
            sudo chmod 644 "$MACON_FS_PLIST"
            # bootstrap is the modern verb and load -w the one macOS 13 may
            # still want; both are tried because a failsafe that is written to
            # disk but never loaded only starts working after the next boot --
            # and the next boot is exactly what it exists for.
            sudo launchctl bootstrap system "$MACON_FS_PLIST" 2>/dev/null ||
                sudo launchctl load -w "$MACON_FS_PLIST" 2>/dev/null || :
            printf 'boot failsafe installed.\n'
            ;;
        remove)
            # The one door that was left unlocked: cli_preflight refuses to arm
            # without the failsafe and uninstall.sh refuses to remove macon
            # while a session holds, but the verb that actually strips the boot
            # failsafe off the machine checked nothing. Run mid-session, a panic
            # at 03:00 then reboots into disablesleep with nothing left to clear
            # it -- the permanent outcome this tool exists to prevent.
            #
            # --force exists because uninstall.sh reaches this verb with those
            # blockers deliberately present; without the passthrough,
            # `uninstall.sh --force` would stop here.
            _fs_force=0
            case "${2:-}" in
                --force) _fs_force=1 ;;
                '') ;;
                *) macon_die "usage: macon failsafe remove [--force]" ;;
            esac
            _fs_blockers=$(cli_failsafe_blockers)
            if [ -n "$_fs_blockers" ] && [ "$_fs_force" -eq 0 ]; then
                cli_explain_failsafe_blockers "$_fs_blockers"
                return 1
            fi
            sudo launchctl bootout system "$MACON_FS_PLIST" 2>/dev/null ||
                sudo launchctl unload -w "$MACON_FS_PLIST" 2>/dev/null || :
            sudo rm -f "$MACON_FS_PLIST"
            # `rm -f` exits 0 for a file it did not remove and for one that was
            # never there, so the file itself is what gets checked. Announcing a
            # removal that did not happen is the same class of lie as reporting
            # a failsafe installed when launchd has never heard of it.
            if [ -f "$MACON_FS_PLIST" ]; then
                macon_die "could not remove $MACON_FS_PLIST; the boot failsafe is still installed"
            fi
            printf 'boot failsafe removed.\n'
            ;;
        status)
            if [ ! -f "$MACON_FS_PLIST" ]; then
                printf 'absent\n'
                return 1
            fi
            if cli_failsafe_loaded; then
                printf 'installed: %s\n' "$MACON_FS_PLIST"
            else
                # Deliberately not matched by install.sh's `installed*` test:
                # this state is a failure, and reporting it as a variant of
                # success is what let the plist-exists check pass for a job
                # that could never run.
                printf 'NOT LOADED: %s\n' "$MACON_FS_PLIST"
                printf "launchd has no job '%s'; the failsafe will not run at boot.\n" \
                    "$MACON_FS_LABEL"
                printf "run 'macon failsafe install' to register it.\n"
                return 1
            fi
            ;;
        *)
            macon_die "usage: macon failsafe {install|remove|status}"
            ;;
    esac
}

if [ -z "${MACON_CLI_SOURCED:-}" ]; then
    case "${1:-}" in
        on) shift; cli_cmd_on "$@" ;;
        run) shift; cli_cmd_run "$@" ;;
        failsafe) shift; cli_cmd_failsafe "$@" ;;
        off) cli_cmd_off ;;
        done) shift; cli_cmd_done "$@" ;;
        status) cli_cmd_status ;;
        saved) cli_cmd_saved ;;
        report) shift; cli_cmd_report "$@" ;;
        log) shift; cli_cmd_log "$@" ;;
        # Not in `macon help`, and deliberately: it exists so install.sh can
        # render the daemon this machine should have using the very CLI it just
        # installed, with that CLI's own MACON_LIB and MACON_LIBEXEC baked in.
        # A verb nobody is meant to type does not belong in the usage text.
        __helper_plist) cli_helper_plist_for_install ;;
        version)
            printf 'macon %s\n' "$MACON_VERSION"
            printf '%s\n' "$MACON_COPYRIGHT"
            ;;
        help | --help | -h | '') cli_usage ;;
        *) cli_check_environment; macon_die "subcommand '$1' is not implemented yet" ;;
    esac
fi
