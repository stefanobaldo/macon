#!/bin/sh
# macon -- short for mac overnight.
# Keep a Mac working with the lid closed, and guarantee the power
# configuration comes back.
#
# This is the unprivileged half of the tool. It parses, validates, and hands a
# descriptor to the root helper; it never runs the watch loop itself.
set -u

MACON_VERSION=0.1.0
MACON_LIB=${MACON_LIB:-/usr/local/libexec/macon/lib}
MACON_LIBEXEC=${MACON_LIBEXEC:-/usr/local/libexec/macon}
MACON_MIN_MACOS=13

# Longest numeric option accepted, in digits. Not hygiene: /bin/sh here is
# bash 3.2, whose `[ -lt ]` parses its operands into intmax_t and EXITS 2 on
# anything larger rather than returning false. An over-long value therefore
# does not fail a comparison, it makes the comparison fall through -- the guard
# stops guarding. lib/session.sh bounds the same class of value for the same
# reason.
MACON_MAX_DIGITS=18

# A session longer than a year is a typo, not a request. The bound exists so
# that the arithmetic building the deadlines stays far away from the overflow
# that would silently produce a ceiling in the past.
MACON_MAX_HOURS=8760

if [ -z "${MACON_CLI_SOURCED:-}" ]; then
    # shellcheck source=lib/common.sh
    . "$MACON_LIB/common.sh"
    # shellcheck source=lib/platform.sh
    . "$MACON_LIB/platform.sh"
    # shellcheck source=lib/decide.sh
    . "$MACON_LIB/decide.sh"
    # shellcheck source=lib/session.sh
    . "$MACON_LIB/session.sh"
    # shellcheck source=lib/snapshot.sh
    . "$MACON_LIB/snapshot.sh"
    # shellcheck source=lib/records.sh
    . "$MACON_LIB/records.sh"
fi

# A plain decimal integer, bounded at both ends and with no leading zeros.
# The zeros matter as much as the magnitude: `[` reads them as decimal and
# $(( )) reads them as octal, so `030` would mean 30 to this guard and 24 to
# the deadline computed from it -- and `08` is not valid octal at all, which is
# a FATAL arithmetic error in a non-interactive shell rather than one this
# function could report.
cli_is_number() {
    case "$1" in
        '' | *[!0-9]*) return 1 ;;
        0) return 0 ;;
        0*) return 1 ;;
    esac
    [ "${#1}" -le "$MACON_MAX_DIGITS" ]
}

# Does this option have its value? Called with the remainder of the argument
# list, so `--max` at the end of the line is refused by name instead of read as
# an unset positional parameter -- which under `set -u` aborts the shell with a
# diagnostic nobody can act on.
cli_need_arg() {
    [ "$#" -ge 2 ] && return 0
    macon_warn "$1 requires a value"
    return 1
}

# Free-form option values become descriptor lines. A newline inside one lands
# as its own KEY=VALUE line, and the key worth forging is hard_ceiling. sess_set
# refuses to write such a value, but these fields are optional, so a refusal
# down there is a field that silently is not there; refused here, the message
# names the flag.
cli_is_single_line() {
    case "$2" in
        *'
'*)
            macon_warn "$1 cannot contain a newline"
            return 1
            ;;
    esac
    return 0
}

cli_usage() {
    cat <<'USAGE'
macon -- short for mac overnight

usage:
  macon on <hours> [options]      keep the Mac awake for <hours>
  macon run [options] -- <cmd>    keep it awake while <cmd> runs
  macon off                       restore power configuration now
  macon status                    show the current state
  macon report [--out FILE]       render an HTML report of past sessions
  macon saved                     show the stored power snapshot
  macon log [--session ID]        show a session's raw samples
  macon failsafe {install|remove|status}
  macon version | help

options for on and run:
  --max <hours>            hard ceiling (default: the requested duration)
  --on-expire restore|extend   what to do at the soft deadline (default: restore)
  --extend-by <minutes>    extension step (default: 30)
  --busy-check <cmd>       completion predicate, run as you; exit 0 means busy
  --sentinel               enable the sentinel file and print its path
  --hook-end <cmd>         run after the restore, with MACON_REASON set
  --hook-warn <cmd>        run --pre-warn minutes before the soft deadline
  --pre-warn <minutes>     warning lead time (default: 15)
  --interval <seconds>     sampling interval (default: 300, floor 30)
  --force                  allow starting on battery
  --no-failsafe            allow starting without the boot failsafe
USAGE
}

# Parses the options shared by `on` and `run`, publishing them as OPT_*.
#
# Those variables ARE the function's return value -- there is no other way for
# a POSIX shell function to hand back thirteen results -- which is why the
# unused-variable check is disabled for the whole function: every OPT_ here is
# an output, and its consumers are the subcommands below and the test suite.
# shellcheck disable=SC2034
cli_parse_on() {
    OPT_HOURS=""
    OPT_MAX=""
    OPT_POLICY=restore
    OPT_EXTEND_BY=30
    OPT_BUSY_CHECK=""
    OPT_SENTINEL=0
    OPT_HOOK_END=""
    OPT_HOOK_WARN=""
    OPT_PRE_WARN=15
    OPT_INTERVAL=300
    OPT_FORCE=0
    OPT_NO_FAILSAFE=0
    OPT_WRAP=0

    if [ "${1:-}" = "--wrap" ]; then
        OPT_WRAP=1
        shift
    else
        OPT_HOURS=${1:-}
        shift 2>/dev/null || :
        if ! cli_is_number "$OPT_HOURS"; then
            macon_warn "a duration in hours is required: macon on <hours>"
            return 1
        fi
        if [ "$OPT_HOURS" -lt 1 ] || [ "$OPT_HOURS" -gt "$MACON_MAX_HOURS" ]; then
            macon_warn "a duration must be between 1 and $MACON_MAX_HOURS hours"
            return 1
        fi
    fi

    while [ $# -gt 0 ]; do
        case "$1" in
            --max)         cli_need_arg "$@" || return 1; OPT_MAX=$2; shift 2 ;;
            --on-expire)   cli_need_arg "$@" || return 1; OPT_POLICY=$2; shift 2 ;;
            --extend-by)   cli_need_arg "$@" || return 1; OPT_EXTEND_BY=$2; shift 2 ;;
            --busy-check)  cli_need_arg "$@" || return 1; OPT_BUSY_CHECK=$2; shift 2 ;;
            --sentinel)    OPT_SENTINEL=1; shift ;;
            --hook-end)    cli_need_arg "$@" || return 1; OPT_HOOK_END=$2; shift 2 ;;
            --hook-warn)   cli_need_arg "$@" || return 1; OPT_HOOK_WARN=$2; shift 2 ;;
            --pre-warn)    cli_need_arg "$@" || return 1; OPT_PRE_WARN=$2; shift 2 ;;
            --interval)    cli_need_arg "$@" || return 1; OPT_INTERVAL=$2; shift 2 ;;
            --force)       OPT_FORCE=1; shift ;;
            --no-failsafe) OPT_NO_FAILSAFE=1; shift ;;
            *)             macon_warn "unknown option: $1"; return 1 ;;
        esac
    done

    case "$OPT_POLICY" in
        restore | extend) ;;
        *) macon_warn "--on-expire must be restore or extend"; return 1 ;;
    esac

    cli_is_single_line --busy-check "$OPT_BUSY_CHECK" || return 1
    cli_is_single_line --hook-end "$OPT_HOOK_END" || return 1
    cli_is_single_line --hook-warn "$OPT_HOOK_WARN" || return 1

    for _opt in "--extend-by:$OPT_EXTEND_BY" "--pre-warn:$OPT_PRE_WARN" \
        "--interval:$OPT_INTERVAL"; do
        if ! cli_is_number "${_opt#*:}"; then
            macon_warn "${_opt%%:*} must be a plain integer: '${_opt#*:}'"
            return 1
        fi
    done

    # Both bounds come from lib/session.sh rather than being restated here: the
    # descriptor is validated against those numbers, so a second copy would be
    # a second place for them to drift -- and drift here means the CLI accepts
    # what the helper then refuses, at arming time, with the message pointing
    # at a descriptor field instead of at the flag that set it.
    if [ "$OPT_INTERVAL" -lt "$MACON_INTERVAL_FLOOR" ]; then
        macon_warn "--interval has a floor of ${MACON_INTERVAL_FLOOR} seconds"
        return 1
    fi
    if [ "$OPT_INTERVAL" -gt "$MACON_INTERVAL_CEIL" ]; then
        macon_warn "--interval has a ceiling of ${MACON_INTERVAL_CEIL} seconds: every deadline is only checked at a poll"
        return 1
    fi

    _has_source=0
    [ -n "$OPT_BUSY_CHECK" ] && _has_source=1
    [ "$OPT_SENTINEL" -eq 1 ] && _has_source=1
    [ "$OPT_WRAP" -eq 1 ] && _has_source=1

    if [ "$OPT_POLICY" = "extend" ]; then
        if [ "$_has_source" -eq 0 ]; then
            macon_warn "--on-expire extend requires a completion source (--busy-check, --sentinel, or run)"
            return 1
        fi
        if [ -z "$OPT_MAX" ]; then
            macon_warn "--on-expire extend requires an explicit --max"
            return 1
        fi
    fi

    if [ -z "$OPT_MAX" ]; then
        OPT_MAX=$OPT_HOURS
    fi
    # Still empty only under --wrap, where the ceiling is the caller's to
    # require; macon run refuses to start without one.
    if [ -n "$OPT_MAX" ]; then
        if ! cli_is_number "$OPT_MAX"; then
            macon_warn "--max must be a plain integer number of hours: '$OPT_MAX'"
            return 1
        fi
        if [ "$OPT_MAX" -lt 1 ] || [ "$OPT_MAX" -gt "$MACON_MAX_HOURS" ]; then
            macon_warn "--max must be between 1 and $MACON_MAX_HOURS hours"
            return 1
        fi
    fi
    if [ "$OPT_WRAP" -eq 0 ] && [ "$OPT_MAX" -lt "$OPT_HOURS" ]; then
        macon_warn "--max cannot be smaller than the requested duration"
        return 1
    fi

    return 0
}

# Where the boot failsafe is registered. Overridable so the tests can prove the
# refusal without a LaunchDaemon on the machine running them.
MACON_FS_PLIST=${MACON_FS_PLIST:-/Library/LaunchDaemons/local.macon.failsafe.plist}

# How long the ladder waits for the helper to report itself, in tenths of a
# second. It has to cover a sudo'd process starting; it must not be long enough
# that a user watches an armed machine with no watcher on it.
MACON_ARM_TRIES=${MACON_ARM_TRIES:-20}

cli_check_environment() {
    _major=$(plat_macos_major)
    if ! cli_is_number "$_major" || [ "$_major" -lt "$MACON_MIN_MACOS" ]; then
        macon_die "macOS $MACON_MIN_MACOS or later is required (found $(sw_vers -productVersion 2>/dev/null))"
    fi
}

# Undoes whatever the ladder had managed to apply. The message matters as much
# as the call: a rollback that itself fails leaves the machine unable to sleep,
# and that is the one outcome the user has to be told about rather than left to
# discover at the airport.
cli_rollback() {
    macon_warn "$1; rolling back"
    if ! snap_restore; then
        macon_warn "THE ROLLBACK DID NOT FULLY SUCCEED -- this Mac may still be unable to sleep"
        macon_warn "check 'macon status', then run 'macon off'; the snapshot is in $(snap_path)"
    fi
}

# Removes run-directory files, escalating only if it has to. /var/run/macon is
# written by root, so a user cannot always clear it -- but the tests point
# MACON_RUN at a directory they own, and a sudo prompt inside a test suite is a
# hang, not a failure. Try unprivileged first and ask for a password only when
# something actually survived.
cli_remove_run_files() {
    rm -f "$@" 2>/dev/null || :
    for _f in "$@"; do
        if [ -e "$_f" ]; then
            sudo rm -f "$@" 2>/dev/null || :
            return 0
        fi
    done
}

# Settings applied, no live helper, heartbeat stale: the machine is holding a
# session nobody is watching, and nothing will end it -- the boot failsafe only
# fires at a boot. Restoring is the way back, and it is safe precisely because
# the orphan test already established there is no session to interrupt.
cli_heal_orphan() {
    _oid=$(sess_get "$(sess_desc_path)" session_id)
    _ostarted=$(sess_get "$(sess_desc_path)" started_at)
    if ! snap_restore; then
        macon_warn "the orphaned session could not be fully restored; check 'macon saved'"
    fi
    cli_remove_run_files "$(sess_desc_path)" "$(sess_pid_path)" "$(sess_heartbeat_path)"
    cli_record_end "$_oid" "$_ostarted" orphan
}

# Writes the index row for a session the helper is not around to close --
# ended by hand, or healed after its helper disappeared. Three of the spec's
# termination reasons have no other writer, and a night missing from the index
# is a night the report cannot show at all.
#
# Both fields are checked because they become columns: an empty start epoch is
# the truncated row that costs the index its sort key, and there is no useful
# row to write for a session nothing can name.
cli_record_end() {
    [ -n "$1" ] || return 0
    if ! cli_is_number "$2"; then
        macon_warn "session '$1' ended ($3) but its start time is unreadable; not recorded"
        return 0
    fi
    rec_close_session "$1" "$2" "$(macon_now)" "$3" ||
        macon_warn "session '$1' ended ($3) but was not recorded"
}

# The activation ladder. Order matters: everything that can fail without
# touching the machine happens first, and every mutation is followed
# immediately by a verification that can roll it back.
#
# DESCRIPTOR is a path the calling user can write; the helper takes its own
# root-owned copy on arrival.
cli_arm() {
    _d=$1

    # Step 1: the first mutation, and the one that matters. Nothing else is
    # attempted if it fails, so there is nothing to undo.
    if ! plat_pmset_disablesleep 1; then
        macon_warn "could not disable clamshell sleep"
        return 1
    fi

    # Only keys this machine actually has: pmset validates the whole key set
    # per invocation, so one key it does not know fails all of them. All of
    # them go in ONE call for the same reason -- applying them one at a time
    # passes through combinations pmset itself rejects.
    _apply=""
    for _k in sleep disksleep powernap; do
        [ -n "$(plat_pmset_read "$_k")" ] && _apply="$_apply $_k 0"
    done
    if [ -n "$_apply" ]; then
        # shellcheck disable=SC2086
        if ! plat_pmset_apply_ac $_apply; then
            cli_rollback "the sleep timers could not be zeroed"
            return 1
        fi
    fi

    # Step 2: start the helper. It must own its own root context from the
    # start: the sudo timestamp would expire overnight and a rollback that
    # needed a password would fail silently.
    #
    # MACON_HELPER_CMD replaces the launcher wholesale, for the tests that
    # have to watch this fail. The descriptor path is in MACON_DESC.
    MACON_DESC=$_d
    export MACON_DESC
    _cmd=${MACON_HELPER_CMD:-}
    if [ -z "$_cmd" ]; then
        _cmd="sudo nohup \"\$MACON_LIBEXEC/macon-helper\" start \"\$MACON_DESC\" >/dev/null 2>&1 &"
    fi
    if ! eval "$_cmd"; then
        cli_rollback "the helper failed to start"
        return 1
    fi

    # Step 3: verify. "Applied without a watcher" must not exist.
    _tries=0
    while [ "$_tries" -lt "$MACON_ARM_TRIES" ]; do
        if sess_helper_alive; then break; fi
        sleep 0.1 2>/dev/null || sleep 1
        _tries=$((_tries + 1))
    done

    if ! sess_helper_alive; then
        cli_rollback "no live helper appeared"
        cli_remove_run_files "$(sess_pid_path)"
        return 1
    fi

    if ! plat_sleep_disabled; then
        cli_rollback "disablesleep did not take effect"
        return 1
    fi

    return 0
}

# Writes one descriptor field, fatally. sess_set refuses values it cannot
# represent, and most of these fields are optional -- so an unchecked write is
# a field that is silently absent, and absence is exactly what sess_validate
# cannot object to. A session that cannot be described is a session that does
# not start.
cli_desc_set() {
    sess_set "$1" "$2" "$3" ||
        macon_die "could not record '$2' in the session descriptor"
}

# The hand-over file. It is built where the calling user can write -- /var/run
# is root-owned -- and it is a DIFFERENT path from the helper's own copy on
# purpose: source and destination being the same file would make the helper's
# validate-then-copy a self-copy, and the tamper resistance it exists for
# (the user cannot move the ceiling once the session is running) would be
# bought with nothing.
cli_new_desc_path() {
    printf '%s/macon-session.%s.conf\n' "${TMPDIR:-/tmp}" "$$"
}

cli_cmd_on() {
    cli_check_environment
    cli_parse_on "$@" || exit 1

    if sess_helper_alive; then
        macon_die "a session is already active; run 'macon off' first"
    fi

    if sess_orphaned; then
        macon_warn "healing an orphaned session before arming"
        cli_heal_orphan
    fi

    if [ "$(plat_power_source)" != "ac" ] && [ "$OPT_FORCE" -eq 0 ]; then
        macon_die "not on AC power; lid closed with sleep disabled and no AC is the worst case this tool can produce (use --force to override)"
    fi

    if [ ! -f "$MACON_FS_PLIST" ] && [ "$OPT_NO_FAILSAFE" -eq 0 ]; then
        macon_die "the boot failsafe is not installed; run 'macon failsafe install' (or pass --no-failsafe)"
    fi

    if ! snap_exists; then
        if ! snap_save; then
            macon_die "no snapshot exists and the machine already looks modified; restore the values you want by hand and try again -- macOS exposes no defaults to reconstruct them"
        fi
        printf 'saved original power state to %s\n' "$(snap_path)"
        printf 'plist backup in %s\n' "$(snap_backup_plists)"
    fi

    _id=$(macon_new_session_id)
    _now=$(macon_now)
    _d=$(cli_new_desc_path)
    # Created empty and tightened BEFORE anything is written into it: the
    # descriptor names the hooks and the busy-check, which are commands.
    : > "$_d" || macon_die "could not write a session descriptor in ${TMPDIR:-/tmp}"
    chmod 0600 "$_d" 2>/dev/null || :

    cli_desc_set "$_d" session_id "$_id"
    cli_desc_set "$_d" started_at "$_now"
    cli_desc_set "$_d" soft_deadline $((_now + OPT_HOURS * 3600))
    cli_desc_set "$_d" hard_ceiling $((_now + OPT_MAX * 3600))
    cli_desc_set "$_d" policy "$OPT_POLICY"
    cli_desc_set "$_d" extend_by $((OPT_EXTEND_BY * 60))
    cli_desc_set "$_d" pre_warn $((OPT_PRE_WARN * 60))
    cli_desc_set "$_d" interval "$OPT_INTERVAL"
    cli_desc_set "$_d" strikes 2
    cli_desc_set "$_d" user "$(id -un)"
    cli_desc_set "$_d" hook_end "$OPT_HOOK_END"
    cli_desc_set "$_d" hook_warn "$OPT_HOOK_WARN"
    cli_desc_set "$_d" busy_timeout 30

    if [ -n "$OPT_BUSY_CHECK" ]; then
        cli_desc_set "$_d" completion busy_check
        cli_desc_set "$_d" busy_check "$OPT_BUSY_CHECK"
    elif [ "$OPT_SENTINEL" -eq 1 ]; then
        cli_desc_set "$_d" completion sentinel
        cli_desc_set "$_d" sentinel_path "${MACON_STATE:-$HOME/.local/state/macon}/$_id.done"
    else
        cli_desc_set "$_d" completion none
    fi

    sess_validate "$_d" || macon_die "internal error: built an invalid session descriptor"

    _soft=$(sess_get "$_d" soft_deadline)
    _hard=$(sess_get "$_d" hard_ceiling)
    _sentinel=$(sess_get "$_d" sentinel_path)

    if ! cli_arm "$_d"; then
        rm -f "$_d"
        exit 1
    fi
    # The helper works from its own copy from here on, so this one is not just
    # redundant, it is a second copy of the session's commands sitting in a
    # temporary directory.
    rm -f "$_d"

    if [ "$OPT_SENTINEL" -eq 1 ]; then
        printf 'sentinel: %s\n' "$_sentinel"
        printf 'write that file when the work is done and macon will restore and sleep.\n'
    fi
    printf 'armed until %s (ceiling %s)\n' \
        "$(date -r "$_soft" '+%H:%M')" \
        "$(date -r "$_hard" '+%H:%M')"
    printf 'safe to close the lid.\n'
}

# Stops the watch loop and clears the run directory. The helper goes first and
# the restore follows: a helper still polling against a descriptor that has
# been deleted reads every field as empty, and empty operands are exactly what
# `[ -ge ]` exits 2 on -- a loop that no longer evaluates any of its rungs.
cli_stop_helper() {
    sess_helper_alive || return 0
    _p=$(cat "$(sess_pid_path)" 2>/dev/null)

    # Unprivileged first: the helper runs as root, but the tests do not, and a
    # sudo prompt inside a suite is a hang rather than a failure.
    kill "$_p" 2>/dev/null || sudo kill "$_p" 2>/dev/null || :

    _tries=0
    while [ "$_tries" -lt "$MACON_ARM_TRIES" ] && kill -0 "$_p" 2>/dev/null; do
        sleep 0.1 2>/dev/null || sleep 1
        _tries=$((_tries + 1))
    done
    if kill -0 "$_p" 2>/dev/null; then
        macon_warn "the helper (pid $_p) did not stop; restoring anyway"
    fi
}

cli_cmd_off() {
    _d=$(sess_desc_path)
    _id=$(sess_get "$_d" session_id)
    _started=$(sess_get "$_d" started_at)

    cli_stop_helper
    cli_remove_run_files "$_d" "$(sess_pid_path)" "$(sess_heartbeat_path)"

    if snap_exists; then
        if snap_restore; then
            rm -f "$(snap_path)"
            printf 'power configuration restored.\n'
        else
            # A restore that failed has not consumed the snapshot, and macOS
            # cannot reconstruct what it holds. Deleting it here would destroy
            # the only record of the original values while the machine is still
            # holding the wrong ones.
            macon_warn "the restore did not fully succeed; the snapshot is kept in $(snap_path)"
            macon_warn "check 'macon status' before closing the lid again"
        fi
    else
        macon_warn "no snapshot in $(snap_path); only disablesleep can be cleared"
        macon_warn "if sleep/disksleep/powernap are zeroed, set them by hand:"
        macon_warn "  sudo pmset -c sleep <min> disksleep <min> powernap <0|1>"
        # Still worth running: it clears disablesleep, which is the half that
        # decides whether the lid can be closed at all.
        snap_restore || :
        printf 'clamshell sleep re-enabled.\n'
    fi

    cli_record_end "$_id" "$_started" manual
}

_cli_row() {
    printf '%-17s %s\n' "$1" "$2"
}

cli_cmd_status() {
    if plat_sleep_disabled; then
        _cli_row "clamshell sleep:" "DISABLED (safe to close the lid)"
    else
        _cli_row "clamshell sleep:" "active (closing the lid suspends)"
    fi
    _cli_row "battery:" "$(plat_battery_pct)%"
    _cli_row "power source:" "$(plat_power_source)"
    _cli_row "ac sleep/disk/np:" \
        "$(plat_pmset_read sleep) / $(plat_pmset_read disksleep) / $(plat_pmset_read powernap)"

    if sess_helper_alive; then
        _d=$(sess_desc_path)
        _soft=$(sess_get "$_d" soft_deadline)
        if cli_is_number "$_soft"; then
            _left=$(( _soft - $(macon_now) ))
            [ "$_left" -lt 0 ] && _left=0
            _cli_row "session:" "active, $((_left / 3600))h$(( (_left % 3600) / 60 ))m to the soft deadline"
        else
            _cli_row "session:" "active, with an unreadable deadline"
        fi
        _cli_row "policy:" "$(sess_get "$_d" policy) / completion: $(sess_get "$_d" completion)"
    elif sess_orphaned; then
        # Reported, never healed: a read command stays a read command. A status
        # that quietly restored would erase the state it is describing.
        _cli_row "session:" "ORPHANED -- settings applied with no live helper"
        printf "run 'macon off' to restore.\n"
    else
        _cli_row "session:" "none"
    fi

    if [ -f "$MACON_FS_PLIST" ]; then
        _cli_row "boot failsafe:" "installed"
    else
        _cli_row "boot failsafe:" "absent"
    fi

    _last=$(rec_sessions 0 | head -1)
    if [ -n "$_last" ]; then
        _cli_row "last session:" \
            "$(printf '%s' "$_last" | cut -f4), worst thermal $(printf '%s' "$_last" | cut -f5)"
    fi
}

cli_cmd_saved() {
    if snap_exists; then
        printf 'snapshot (%s):\n' "$(snap_path)"
        sed 's/^/  /' "$(snap_path)"
        printf "'macon off' will apply: pmset -a disablesleep 0; pmset -c %s\n" \
            "$(snap_restore_args)"
    else
        printf 'no snapshot -- nothing was modified, or macon off already ran.\n'
    fi
}

cli_cmd_log() {
    _id=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --session) cli_need_arg "$@" || exit 1; _id=$2; shift 2 ;;
            -*)        macon_die "unknown option: $1" ;;
            *)         _id=$1; shift ;;
        esac
    done

    if [ -z "$_id" ]; then
        _id=$(rec_sessions 0 | head -1 | cut -f1)
    fi
    [ -n "$_id" ] || macon_die "no sessions recorded yet"

    # The id becomes a path, and this one was typed on the command line. The
    # records module refuses what it cannot use as a filename.
    _p=$(rec_samples_path "$_id") || macon_die "'$_id' is not a usable session id"
    [ -f "$_p" ] || macon_die "no samples for session $_id"
    cat "$_p"
}

# Where this user's snapshot and records live. The same expression the library
# modules default to, restated here because the CLI needs the value itself --
# to name it in the LaunchDaemon's environment.
cli_state_dir() {
    printf '%s\n' "${MACON_STATE:-$HOME/.local/state/macon}"
}

# XML text, not markup: a path is data, and an unescaped & or < makes the plist
# unparseable. launchd's response to a plist it cannot parse is to not run the
# job -- which for this job means no boot restore at all, discovered on the
# morning it was needed.
cli_xml_escape() {
    printf '%s' "$1" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'
}

# Renders the LaunchDaemon. PROGRAM is the failsafe; STATE_DIR, when given, is
# written into the job's environment.
#
# That second argument is what makes the boot restore deterministic. launchd
# starts a system daemon with no user context, so the snapshot's default
# location -- under the invoking user's home -- resolves to nothing. The
# failsafe can search for a snapshot itself, but on a multi-user Mac that
# search picks the most recently written one, which is a guess. Naming the
# directory at install time leaves the search as the safety net it was meant
# to be.
cli_failsafe_plist() {
    _prog=$(cli_xml_escape "$1")
    _state=${2:-}
    _env=""
    if [ -n "$_state" ]; then
        _env=$(printf '  <key>EnvironmentVariables</key>\n  <dict><key>MACON_STATE</key><string>%s</string></dict>' \
            "$(cli_xml_escape "$_state")")
    fi
    cat <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>local.macon.failsafe</string>
  <key>RunAtLoad</key><true/>
  <key>ProgramArguments</key>
  <array><string>$_prog</string></array>
${_env}
</dict>
</plist>
PLIST
}

# The plist this machine should have: the installed failsafe, and the state
# directory of the user installing it. Separate from the install verb so what
# would be written can be asserted without a test suite that registers a
# boot-time root daemon.
cli_failsafe_plist_for_install() {
    cli_failsafe_plist "$MACON_LIBEXEC/failsafe.sh" "$(cli_state_dir)"
}

cli_cmd_failsafe() {
    case "${1:-status}" in
        install)
            cli_failsafe_plist_for_install | sudo tee "$MACON_FS_PLIST" >/dev/null
            sudo chown root:wheel "$MACON_FS_PLIST"
            sudo chmod 644 "$MACON_FS_PLIST"
            # bootstrap is the modern verb and load -w the one macOS 13 may
            # still want; both are tried because a failsafe that is written to
            # disk but never loaded only starts working after the next boot --
            # and the next boot is exactly what it exists for.
            sudo launchctl bootstrap system "$MACON_FS_PLIST" 2>/dev/null ||
                sudo launchctl load -w "$MACON_FS_PLIST" 2>/dev/null || :
            printf 'boot failsafe installed.\n'
            ;;
        remove)
            sudo launchctl bootout system "$MACON_FS_PLIST" 2>/dev/null ||
                sudo launchctl unload -w "$MACON_FS_PLIST" 2>/dev/null || :
            sudo rm -f "$MACON_FS_PLIST"
            printf 'boot failsafe removed.\n'
            ;;
        status)
            if [ -f "$MACON_FS_PLIST" ]; then
                printf 'installed: %s\n' "$MACON_FS_PLIST"
            else
                printf 'absent\n'
            fi
            ;;
        *)
            macon_die "usage: macon failsafe {install|remove|status}"
            ;;
    esac
}

if [ -z "${MACON_CLI_SOURCED:-}" ]; then
    case "${1:-}" in
        on) shift; cli_cmd_on "$@" ;;
        failsafe) shift; cli_cmd_failsafe "$@" ;;
        off) cli_cmd_off ;;
        status) cli_cmd_status ;;
        saved) cli_cmd_saved ;;
        log) shift; cli_cmd_log "$@" ;;
        version) printf 'macon %s\n' "$MACON_VERSION" ;;
        help | --help | -h | '') cli_usage ;;
        *) cli_check_environment; macon_die "subcommand '$1' is not implemented yet" ;;
    esac
fi
